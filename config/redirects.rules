# MBL platform-neutral redirect policy.
# Syntax: <source> <target> <status>. Supported statuses: 301, 307, 404, 410.
# `*` matches a trailing path and `:name` matches exactly one path segment.

http://mebel-irkutsk.ru/* https://mebel-irkutsk.ru/:splat 301
http://www.mebel-irkutsk.ru/* https://mebel-irkutsk.ru/:splat 301
https://www.mebel-irkutsk.ru/* https://mebel-irkutsk.ru/:splat 301
http://mebelirkutsk.ru/* https://mebel-irkutsk.ru/:splat 301
http://www.mebelirkutsk.ru/* https://mebel-irkutsk.ru/:splat 301
https://mebelirkutsk.ru/* https://mebel-irkutsk.ru/:splat 301
https://www.mebelirkutsk.ru/* https://mebel-irkutsk.ru/:splat 301

/api/contact /api/leads 307

# Explicit status pages
/404 /404.html 404

