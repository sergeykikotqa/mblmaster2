# Example environment variables for contact webhook
# Set CONTACT_WEBHOOK_URL to your external CRM/webhook endpoint (HTTPS is required; leave empty to disable)
CONTACT_WEBHOOK_URL=https://example.com/your-webhook
# Legacy CONTACT_WEBHOOK is accepted temporarily but must also use HTTPS.

# Shared secret used to HMAC-sign payloads (optional)
CONTACT_WEBHOOK_SECRET=replace_with_a_secure_secret

# Request timeout for webhook delivery in milliseconds
CONTACT_WEBHOOK_TIMEOUT_MS=5000

# Number of retries for webhook delivery (exponential backoff)
CONTACT_WEBHOOK_RETRIES=2

# Base retry delay in milliseconds (exponential factor)
CONTACT_WEBHOOK_RETRY_DELAY_MS=1000

# Worker endpoint token (required in production)
CONTACT_WORKER_TOKEN=replace_with_worker_token
# Optional dedicated token for /api/workers/metrics-snapshot
# If empty, CONTACT_WORKER_TOKEN is used as fallback.
METRICS_WORKER_TOKEN=
# Optional dedicated token for /api/workers/metrics-health-eval
# If empty, METRICS_WORKER_TOKEN and CONTACT_WORKER_TOKEN are used as fallback.
METRICS_HEALTH_WORKER_TOKEN=

# Optional full worker URL override (default: /api/workers/lead-delivery)
# CONTACT_WORKER_URL=https://your-domain.tld/api/workers/lead-delivery

# Optional worker trigger tuning from /api/leads (legacy alias: /api/contact)
CONTACT_WORKER_TRIGGER_LIMIT=3
CONTACT_WORKER_TRIGGER_TIMEOUT_MS=800

# Lead retry worker settings
CONTACT_WORKER_BATCH_SIZE=20
# Local production sidecar cadence. It calls the private worker endpoint;
# no public scheduler or external cron is required.
WORKER_TRIGGER_INTERVAL_MS=15000
WORKER_TRIGGER_TIMEOUT_MS=10000
WORKER_TRIGGER_BATCH_LIMIT=20
# Processing lock TTL to prevent duplicate concurrent delivery attempts for the same lead
CONTACT_WORKER_PROCESSING_LOCK_TTL_SEC=120
# Worker cadence is 15s; four missed cycles mark the heartbeat stale.
CONTACT_WORKER_HEARTBEAT_STALE_SEC=60
# Pending queue age bands used by protected admin health diagnostics.
CONTACT_QUEUE_OLDEST_NORMAL_SEC=60
CONTACT_QUEUE_OLDEST_WARNING_SEC=120
CONTACT_QUEUE_OLDEST_CRITICAL_SEC=600
CONTACT_DELIVERY_MAX_RETRIES=6
CONTACT_RETRY_BASE_DELAY_SEC=30
CONTACT_DLQ_TTL_SEC=2592000

# Lead submission fails closed when Redis is unavailable; direct webhook bypass is disabled.

# Optional DLQ incident alert webhook
CONTACT_ALERT_WEBHOOK_URL=
CONTACT_ALERT_WEBHOOK_URL_SECONDARY=
CONTACT_ALERT_WEBHOOK_TOKEN=
CONTACT_ALERT_TIMEOUT_MS=3000
CONTACT_ALERT_MAX_RETRIES=1
CONTACT_ALERT_RETRY_BASE_DELAY_MS=500
# Cooldown for lead-store degraded alerts (seconds)
CONTACT_LEAD_STORE_DEGRADED_ALERT_COOLDOWN_SEC=900

# Health warning threshold for retry rate (e.g. 0.1 = 10%)
CONTACT_RETRY_RATE_ALERT_THRESHOLD=0.1
CONTACT_RETRY_RATE_ALERT_COOLDOWN_SEC=600
# Replay lock to prevent immediate replay storms from DLQ CLI
CONTACT_DLQ_REPLAY_LOCK_SEC=900
# DLQ replay audit storage tuning
DLQ_AUDIT_REDIS_ENABLED=true
DLQ_AUDIT_REDIS_MAX_ENTRIES=5000
DLQ_AUDIT_REDIS_TTL_SEC=7776000

# Bot protection (Yandex SmartCaptcha). Production is always fail-closed.
# The client key is public in the browser, but both keys stay in the VPS env
# and outside Git/release bundles; /api/captcha/config exposes only the client key.
CONTACT_SMARTCAPTCHA_REQUIRED=true
CONTACT_SMARTCAPTCHA_DEGRADED_ALERT_COOLDOWN_SEC=900
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_TIMEOUT_MS=4000
# Exact comma-separated hostnames configured in the Yandex Cloud CAPTCHA.
SMARTCAPTCHA_ALLOWED_HOSTS=mebel-irkutsk.ru,www.mebel-irkutsk.ru
# Local integration tests only. The application accepts an override only when
# this flag is true and the URL host is localhost/127.0.0.1/::1.
SMARTCAPTCHA_ALLOW_LOCAL_VERIFY_OVERRIDE=false
SMARTCAPTCHA_VERIFY_URL=

# If true, /api/health/lead-pipeline returns 503 when DLQ incident is detected.
# Keep false for uptime probes and use ?strict=1 for incident-oriented checks.
CONTACT_LEAD_PIPELINE_HEALTH_STRICT_STATUS=false

# Idempotency dedupe window in seconds (same key/hash -> same leadId + duplicate=true)
CONTACT_IDEMPOTENCY_WINDOW_SEC=120

# Lead record retention in seconds (default 30 days)
CONTACT_LEAD_RECORD_TTL_SEC=2592000
# Backup log for forensic/debug purposes.
# In production keep disabled unless incident response requires temporary capture.
CONTACT_LEAD_BACKUP_ENABLED=false
# Include raw lead PII (name/phone/message/ip) in backup log.
# Keep false in production.
CONTACT_LEAD_BACKUP_INCLUDE_PII=false

# Rate-limit for /api/leads (legacy alias: /api/contact)
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SEC=600

# Trust proxy forwarding headers (x-forwarded-for/x-vercel-forwarded-for) only when explicitly enabled
CONTACT_TRUST_PROXY_HEADERS=false
TRACK_TRUST_PROXY_HEADERS=false

# Native Redis connection required for production durable queue (redis:// or rediss://).
REDIS_URL=
CONTACT_REDIS_PREFIX=lead
# Redis client runtime resilience (retry + circuit breaker)
CONTACT_REDIS_TIMEOUT_MS=1200
CONTACT_REDIS_MAX_ATTEMPTS=2
CONTACT_REDIS_RETRY_BASE_DELAY_MS=120
CONTACT_REDIS_CIRCUIT_FAILURE_THRESHOLD=3
CONTACT_REDIS_CIRCUIT_OPEN_MS=15000

# Production Redis data volume. Create it once before first deploy. Keeping it
# external protects real lead data from `docker compose down -v`.
MBL_REDIS_VOLUME_NAME=mbl-production-redis-data
MBL_REDIS_VOLUME_EXTERNAL=true

# O2.4 encrypted off-host Redis backup. The secret directory is a root-owned
# host directory and must contain files named: repository, password,
# s3-access-key and s3-secret-key. Never commit that directory.
MBL_BACKUP_SECRET_DIR=./secrets/backup
MBL_BACKUP_STATUS_DIR=./var/backup-status
MBL_BACKUP_RESTORE_DIR=./var/restore
MBL_BACKUP_S3_REGION=ru-central1
# A successful hourly backup stays fresh for 2h15m. Five minutes of future
# clock skew is tolerated; larger skew makes the checkpoint invalid.
MBL_BACKUP_MAX_AGE_SEC=8100
MBL_BACKUP_FUTURE_TOLERANCE_SEC=300
# Optional in-container secret paths when Redis auth or temporary S3
# credentials are enabled by the operator.
MBL_BACKUP_S3_SESSION_TOKEN_FILE_IN_CONTAINER=
MBL_BACKUP_REDIS_PASSWORD_FILE_IN_CONTAINER=
# Initial retention contract: 24 hourly, 7 daily and 4 weekly snapshots.
MBL_BACKUP_KEEP_HOURLY=24
MBL_BACKUP_KEEP_DAILY=7
MBL_BACKUP_KEEP_WEEKLY=4

# Dedicated read-only bearer token for /api/monitoring/health. Keep it
# separate from METRICS_ADMIN_TOKEN and store it only in production secrets.
MBL_MONITORING_TOKEN=

# Dedicated service credential for the minimum read-only owner aggregates at
# /api/monitoring/owner-metrics. Never reuse METRICS_ADMIN_TOKEN or
# MBL_MONITORING_TOKEN. Install the same value only on the independent monitor.
MBL_OWNER_METRICS_TOKEN=

# Public analytics and lead tracking flags
PUBLIC_PRIMARY_SEO_CITY_ID=irkutsk
PUBLIC_ENABLE_LEAD_TRACKING=true
PUBLIC_YANDEX_METRIKA_ID=
PUBLIC_YANDEX_VERIFICATION=
PUBLIC_GA4_ID=
PUBLIC_LEAD_FORM_ABANDON_MS=60000
PUBLIC_ENABLE_RUM_WEB_VITALS=true
PUBLIC_RUM_LCP_ALERT_THRESHOLD_MS=2500

# LocalBusiness JSON-LD placeholders (Layout.astro)
PUBLIC_BUSINESS_PHONE=+79025551234
PUBLIC_BUSINESS_EMAIL=owner@example.invalid
PUBLIC_BUSINESS_STREET_ADDRESS=ул. Красных Героев, 5
PUBLIC_BUSINESS_ADDRESS_LOCALITY=Иркутск
PUBLIC_BUSINESS_ADDRESS_DISTRICT=Куйбышевский район
PUBLIC_BUSINESS_REGION=Иркутская область
PUBLIC_BUSINESS_POSTAL_CODE=664000
PUBLIC_BUSINESS_LAT=52.2864
PUBLIC_BUSINESS_LON=104.2808
PUBLIC_BUSINESS_PRICE_RANGE=₽₽
PUBLIC_BUSINESS_OPENING_HOURS=Mo-Fr 09:00-20:00;Sa 10:00-18:00
PUBLIC_BUSINESS_OPENING_HOURS_TEXT=Пн–Пт: 09:00–20:00; Сб: 10:00–18:00
PUBLIC_BUSINESS_IMAGE=https://assets.example.invalid/business.jpg
PUBLIC_BUSINESS_SAME_AS=https://social.example.invalid/mbl
PUBLIC_TELEGRAM_URL=https://t.me/example
PUBLIC_BUSINESS_YANDEX_MAPS_URL=https://yandex.example.invalid/maps/mbl
PUBLIC_BUSINESS_GOOGLE_MAPS_URL=https://google.example.invalid/maps/mbl
PUBLIC_BUSINESS_LEGAL_NAME=ИП Тестовый Владелец
PUBLIC_BUSINESS_TAX_ID=000000000000
PUBLIC_BUSINESS_REGISTRATION_ID=000000000000000
PUBLIC_BUSINESS_CHECKING_ACCOUNT=00000000000000000000
PUBLIC_BUSINESS_BIC=000000000
PUBLIC_BUSINESS_BANK_NAME=Тестовый банк
PUBLIC_BUSINESS_REGISTERED_ADDRESS=Иркутск, тестовый адрес

# Optional RUM alert channel (for high LCP incidents from real users)
RUM_ALERT_WEBHOOK_URL=
RUM_ALERT_WEBHOOK_TOKEN=
RUM_ALERT_TIMEOUT_MS=3000
# RUM anti-noise aggregation window settings
RUM_ALERT_WINDOW_MS=600000
RUM_ALERT_MIN_SAMPLES=30
RUM_ALERT_MIN_VIOLATION_RATE=0.25
RUM_ALERT_COOLDOWN_MS=900000
RUM_ALERT_METRIC_ID_TTL_MS=3600000

# Public site URL used for canonical/sitemap generation (required in production build)
PUBLIC_SITE_URL=https://your-real-domain.tld
# Comma-separated allowlist of district page slugs that are indexable (others remain noindex)
SEO_INDEXABLE_DISTRICT_PAGE_SLUGS=
# Comma-separated district page slugs with noindex,nofollow robots policy
SEO_NOINDEX_NOFOLLOW_PAGE_SLUGS=
# Hard cap for generated factory pages to prevent accidental overgeneration
MAX_GENERATED_PAGES=200
# Maximum allowed noindex share in generated pages (0..1) for JSON->HTML parity gate
MAX_NOINDEX_SHARE=0.7
# Minimum unique internal source pages linking to each indexable generated page
INDEXABLE_MIN_INBOUND_LINKS=3

# Admin access for metrics endpoints (/api/admin/* and /api/metrics/rollup legacy alias)
# METRICS_ADMIN_TOKEN is required in production.
# ADMIN_ALLOWLIST_IPS is optional additional control (comma-separated, supports CIDR).
METRICS_ADMIN_TOKEN=
ADMIN_ALLOWLIST_IPS=
# Trust proxy chain headers (x-forwarded-for/forwarded/x-vercel-forwarded-for) for admin IP auth.
# Keep false unless your platform/proxy chain is explicitly trusted.
ADMIN_TRUST_PROXY_HEADERS=false
# Allow admin/worker unauthenticated dev bypass when tokens are not configured.
# Must stay false in production.
ALLOW_DEV_BYPASS=false
# Force production auth mode in local/dev for smoke testing (optional)
ADMIN_AUTH_FORCE_PROD_MODE=false
# Auth-failure rate limiting for admin endpoints
ADMIN_AUTH_FAIL_WINDOW_SEC=60
ADMIN_AUTH_FAIL_MAX_ATTEMPTS=10
ADMIN_AUTH_FAIL_BLOCK_SEC=600

# Daily conversion snapshot + anomaly thresholds
METRICS_SNAPSHOT_BASELINE_DAYS=7
METRICS_SNAPSHOT_CR_DROP_THRESHOLD=0.3
METRICS_SNAPSHOT_CR_DROP_MIN_OPENED=10
METRICS_SNAPSHOT_ZERO_SUBMITTED_OPENED_MIN=15
METRICS_SNAPSHOT_OPENED_SPIKE_MULTIPLIER=3
METRICS_SNAPSHOT_SUBMITTED_SPIKE_MULTIPLIER=3
METRICS_SNAPSHOT_SPIKE_MIN_OPENED=20
METRICS_SNAPSHOT_SPIKE_MIN_SUBMITTED=10
METRICS_SNAPSHOT_OPENED_UP_SUBMITTED_DOWN_FACTOR=0.5
METRICS_SNAPSHOT_RETENTION_SEC=15552000

# Conversion Health State Machine (signal + hysteresis + transition stream retention)
METRICS_HEALTH_MIN_VOLUME=12
METRICS_HEALTH_BASELINE_MIN_VOLUME=10
METRICS_HEALTH_ZERO_SUBMITTED_OPENED_MIN=15
METRICS_HEALTH_CR_DROP_WARN_PCT=0.2
METRICS_HEALTH_CR_DROP_CRITICAL_PCT=0.35
METRICS_HEALTH_OPENED_SPIKE_MULTIPLIER=1.8
METRICS_HEALTH_OPENED_DROP_MULTIPLIER=0.6
METRICS_HEALTH_HIGH_VOLATILITY_PCT=0.35
METRICS_HEALTH_REQUIRE_STABLE_DAYS=2
METRICS_HEALTH_MIN_STATE_DURATION_DAYS=1
METRICS_HEALTH_TRANSITION_MAXLEN=5000
METRICS_HEALTH_STORE_FALLBACK_ALERT_COOLDOWN_SEC=900
# If true, /api/health returns 503 when overall conversion health is critical (production only).
METRICS_HEALTH_STRICT_STATUS=false
# Precedence: METRICS_HEALTH_STRICT_STATUS > LEAD_METRICS_HEALTH_STRICT_STATUS > false.
# Deprecated fallback for strict mode (read only when METRICS_HEALTH_STRICT_STATUS is not set).
# Remove after environments are migrated.
LEAD_METRICS_HEALTH_STRICT_STATUS=

# CI runtime config gate tuning
RUNTIME_CONFIG_CHECK_TIMEOUT_MS=5000
RUNTIME_CONFIG_CHECK_RETRY_ATTEMPTS=3
RUNTIME_CONFIG_CHECK_RETRY_BASE_DELAY_MS=400

# Post-deploy smoke checks
DEPLOY_SMOKE_BASE_URL=https://preview.example.com
DEPLOY_SMOKE_WORKER_TOKEN=
DEPLOY_SMOKE_EXPECT_SMARTCAPTCHA=false
DEPLOY_SMOKE_SMARTCAPTCHA_TOKEN=
DEPLOY_SMOKE_TIMEOUT_MS=12000
DEPLOY_SMOKE_BUDGET_MS=120000
DEPLOY_SMOKE_RETRY_ATTEMPTS=3
DEPLOY_SMOKE_RETRY_BASE_DELAY_MS=800
# If true, transient smoke failures are treated as degraded warning instead of CI failure
DEPLOY_SMOKE_ALLOW_DEGRADED=false
