# Install as /etc/mbl-monitor/monitor.env on the independent monitoring host.
# Keep mode 0600 and never store real values in Git.
MBL_MONITOR_BASE_URL=https://mebel-irkutsk.ru
MBL_MONITOR_TOKEN=
MBL_MONITOR_SUCCESS_URL=
MBL_MONITOR_FAILURE_URL=
MBL_MONITOR_TIMEOUT_MS=10000
MBL_MONITOR_TLS_WARNING_DAYS=30
MBL_MONITOR_TLS_CRITICAL_DAYS=14

MBL_TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MBL_TELEGRAM_STATE_FILE=/var/lib/mbl-monitor/telegram-state.json
MBL_TELEGRAM_ESCALATION_SEC=21600
MBL_TELEGRAM_RETRY_SEC=300
MBL_TELEGRAM_TIMEOUT_MS=8000
MBL_TELEGRAM_MAX_RETRIES=1

# Telegram Admin Read-Only v1. The same bot is used, but only this exact
# private sender/chat pair may run commands. Keep the service token distinct
# from MBL_MONITOR_TOKEN and the browser admin token.
MBL_TELEGRAM_ADMIN_USER_ID=
MBL_TELEGRAM_ADMIN_CHAT_ID=
MBL_TELEGRAM_ADMIN_STATE_FILE=/var/lib/mbl-monitor/telegram-admin-state.json
MBL_MONITOR_STATUS_FILE=/var/lib/mbl-monitor/status-snapshot.json
MBL_TELEGRAM_ADMIN_TIMEOUT_MS=6000
MBL_OWNER_METRICS_TOKEN=
