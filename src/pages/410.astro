---
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Страница удалена',
  description: 'Запрошенная страница больше недоступна.',
  robots: {
    index: false,
    follow: false,
  },
};

Astro.response.status = 410;
---

<PageLayout metadata={metadata}>
  <section class="max-w-3xl mx-auto px-4 py-16 sm:py-20">
    <div class="ds-card-soft p-8 sm:p-10">
      <div class="ds-pill">Ошибка 410</div>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">410: страница удалена</h1>
      <p class="text-lg text-slate-700 mb-6">
        Этот URL больше не используется. Перейдите на актуальные страницы услуг по городу.
      </p>
      <a href="/kuhni" class="ds-action-primary"> Перейти к услугам </a>
    </div>
  </section>
</PageLayout>
