function normalizeToken(value: unknown): string {
  return String(value || '')
    .trim()
    .toLowerCase()
    .replace(/^\/+|\/+$/g, '');
}

function formatPrice(value: number, currency: string): string {
  const locale = 'ru-RU';
  const normalizedCurrency = currency === 'RUB' ? 'RUB' : currency;
  return new Intl.NumberFormat(locale, {
    style: 'currency',
    currency: normalizedCurrency,
    maximumFractionDigits: 0,
  }).format(value);
}

function formatDaysGenitive(value: number): string {
  const normalized = Math.abs(Math.trunc(value));
  return normalized === 1 ? 'дня' : 'дней';
}

const resolveProjectSlug = (project: ProjectEntry): string => resolveProjectSlugFromAdapter(project);

function formatAreaValue(area: number | undefined): string {
  return typeof area === 'number' && Number.isFinite(area) ? `${area} м²` : '';
}

function buildAdministrativeArea(name: string) {
  return {
    '@type': 'AdministrativeArea',
    name,
  };
}

function formatLayoutLabel(layoutToken: string | undefined): string {
  if (layoutToken === 'straight') return 'прямая планировка';
  if (layoutToken === 'corner') return 'угловая планировка';
  if (layoutToken === 'u-shape') return 'П-образная планировка';
  return '';
}

function buildPriceProofCaseCards(entries: ProjectEntry[]): PriceProofCaseCard[] {
  const candidates = entries
    .map((entry) => {
      const card = buildProjectCardData(entry);
      return {
        entry,
        card,
        slug: resolveProjectSlugFromAdapter(entry),
        publishedAt: Number(new Date(entry.data.publishDate || 0)),
      };
    })
    .filter((record) => Number.isFinite(record.card.priceValue))
    .sort((a, b) => {
      const byPrice = Number(a.card.priceValue) - Number(b.card.priceValue);
      if (byPrice !== 0) return byPrice;
      const byArea = Number(a.card.areaValue || 0) - Number(b.card.areaValue || 0);
      if (byArea !== 0) return byArea;
      return b.publishedAt - a.publishedAt;
    });

  if (candidates.length < 3) return [];

  const lowest = candidates[0];
  const highest = candidates.length > 1 ? candidates[candidates.length - 1] : candidates[0];
  const medianPrice = candidates[Math.floor(candidates.length / 2)]?.card.priceValue ?? lowest.card.priceValue ?? 0;
  const middlePool = candidates.filter((record) => record.slug !== lowest.slug && record.slug !== highest.slug);
  const middle =
    middlePool.slice().sort((a, b) => {
      const aLayoutPriority = a.card.layoutToken === 'straight' || a.card.layoutToken === 'corner' ? 0 : 1;
      const bLayoutPriority = b.card.layoutToken === 'straight' || b.card.layoutToken === 'corner' ? 0 : 1;
      if (aLayoutPriority !== bLayoutPriority) return aLayoutPriority - bLayoutPriority;
      const aDistance = Math.abs((a.card.priceValue ?? medianPrice) - medianPrice);
      const bDistance = Math.abs((b.card.priceValue ?? medianPrice) - medianPrice);
      if (aDistance !== bDistance) return aDistance - bDistance;
      return b.publishedAt - a.publishedAt;
    })[0] || null;

  const selected = [lowest, middle, highest].filter(Boolean).filter((record, index, array) => {
    return array.findIndex((item) => item?.slug === record?.slug) === index;
  });

  return selected.map((record, index) => {
    const layoutLabel = formatLayoutLabel(record?.card.layoutToken);
    const meta = [record?.card.areaLabel, layoutLabel].filter(Boolean).join(' • ');
    const summary = String(record?.card.proofHighlight?.value || record?.card.description || '').trim();
    const label =
      index === 0
        ? 'Стартовый сценарий'
        : index === selected.length - 1
          ? 'Более дорогой проект'
          : 'Сбалансированный сценарий';

    return {
      slug: String(record?.slug || ''),
      href: String(record?.card.href || ''),
      label,
      title: String(record?.card.title || ''),
      priceLabel: String(record?.card.priceLabel || ''),
      meta,
      locationLabel: String(record?.card.locationLabel || ''),
      summary,
    };
  });
}

function buildHybridPriceProofCaseCards(
  entries: ProjectEntry[],
  blocks: Array<LocalCityBlock & { cityModel: (typeof cities)[number] }>
): PriceProofCaseCard[] {
  const blockByCityId = new Map(blocks.map((block) => [normalizeToken(block.city), block]));
  const candidates = entries
    .map((entry) => {
      const card = buildProjectCardData(entry);
      const block = blockByCityId.get(normalizeToken(entry.data.city));
      if (!block) return null;
      return {
        entry,
        block,
        card,
        slug: resolveProjectSlugFromAdapter(entry),
        publishedAt: Number(new Date(entry.data.publishDate || 0)),
      };
    })
    .filter((record): record is NonNullable<typeof record> => Boolean(record));

  if (candidates.length < 3) return [];

  const exactCase =
    candidates
      .filter((record) => Number.isFinite(Number(record.entry?.data.price)))
      .sort((a, b) => {
        const byPublishedAt = Number(b.publishedAt || 0) - Number(a.publishedAt || 0);
        if (byPublishedAt !== 0) return byPublishedAt;
        return Number(a.card.priceValue || 0) - Number(b.card.priceValue || 0);
      })[0] || null;

  if (!exactCase) return [];

  const rangeCases = candidates
    .filter((record) => record.slug !== exactCase.slug)
    .sort((a, b) => {
      const byArea = Number(a.card.areaValue || 0) - Number(b.card.areaValue || 0);
      if (byArea !== 0) return byArea;
      return Number(b.publishedAt || 0) - Number(a.publishedAt || 0);
    })
    .slice(0, 2);

  if (rangeCases.length < 2) return [];

  const selected = [exactCase, ...rangeCases].sort((a, b) => {
    const byArea = Number(a.card.areaValue || 0) - Number(b.card.areaValue || 0);
    if (byArea !== 0) return byArea;
    return Number(a.card.priceValue || 0) - Number(b.card.priceValue || 0);
  });

  return selected.map((record) => {
    const layoutLabel = formatLayoutLabel(record.card.layoutToken);
    const meta = [record.card.areaLabel, layoutLabel].filter(Boolean).join(' • ');
    const summary = String(record.card.proofHighlight?.value || record.card.description || '').trim();
    const isExactCase = record.slug === exactCase.slug;
    const hasEstimatedPrice = Boolean(record.card.priceIsEstimated && record.card.priceValue);
    const cityLabel = record.block.cityModel.name || '';

    return {
      slug: String(record.slug || ''),
      href: String(record.card.href || ''),
      label: isExactCase
        ? 'Кейс с точной ценой'
        : hasEstimatedPrice
          ? 'Оценка по фото и аналогам'
          : `${cityLabel} - рабочий диапазон`,
      title: String(record.card.title || ''),
      priceLabel: isExactCase
        ? String(record.card.priceLabel || '')
        : hasEstimatedPrice
          ? String(record.card.priceLabel || '')
          : `${formatPrice(record.block.priceRange.from || 0, record.block.priceRange.currency || 'RUB')} - ${formatPrice(record.block.priceRange.to || 0, record.block.priceRange.currency || 'RUB')}`,
      meta,
      locationLabel: String(record.card.locationLabel || ''),
      summary,
      note: isExactCase
        ? 'Точная сумма указана по завершенному проекту.'
        : hasEstimatedPrice
          ? String(record.card.priceNote || '').trim() ||
            'Оценка по фото и близким кейсам; точная смета зависит от наполнения и материалов.'
          : `Диапазон подтвержден для ${record.block.cityModel.nameGenitive || cityLabel}; точная смета зависит от площади и наполнения.`,
    };
  });
}

export function getStaticPaths() {
  return getGeneratedPages()
    .filter((page) => page.pageType === 'service-money')
    .map((page) => ({
      params: {
        service: normalizePath(page.pageSlug).split('/').filter(Boolean)[0],
      },
      props: {
        page,
      },
    }));
}

const paramsService = Astro.params.service || '';
const pageFromProps = (Astro.props as { page?: GeneratedGeoPage }).page;
const page = pageFromProps || getGeneratedPageBySlug(normalizePath(`/${paramsService}`));

if (!page || page.pageType !== 'service-money') {
  throw new Error(`[factory-service-money] unknown route: service="${paramsService}"`);
}

const serviceToken = normalizeToken(normalizePath(page.pageSlug).slice(1));
const service = getServiceById(page.serviceId);
if (!service) {
  throw new Error(`[factory-service-money] unresolved service for "${page.pageSlug}"`);
}
const currentServiceName = page.serviceName;

const serviceConfig = SERVICE_VIEW[service.id] || SERVICE_VIEW['kuhni-na-zakaz'];
const cities = getCities();
const primaryCity = cities[0];
const siteUrl = Astro.site ? new URL(Astro.site).toString().replace(/\/$/, '') : '';
const companyName = (process.env.SITE_NAME || 'мбл мастер').trim();
const businessInfo = getBusinessInfo(siteUrl);
const canonicalPath = toCanonical(page.pageSlug, Astro.site);
const canonicalUrl = toAbsoluteUrl(canonicalPath, Astro.site);
const businessId = siteUrl ? `${siteUrl}/#business` : '#business';
const serviceArea = cities.map((city) => buildAdministrativeArea(city.name));
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: primaryCity ? `${service.name} в ${primaryCity.nameIn || primaryCity.name}` : service.name,
  serviceType: service.name,
  areaServed: serviceArea,
  provider:
    businessId !== '#business'
      ? { '@id': businessId }
      : {
          '@type': 'LocalBusiness',
          name: companyName,
          telephone: businessInfo.phone,
          address: {
            '@type': 'PostalAddress',
            addressCountry: 'RU',
            addressRegion: businessInfo.addressRegion,
            addressLocality: businessInfo.addressLocality,
            postalCode: businessInfo.postalCode,
            streetAddress: businessInfo.streetAddress,
          },
        },
  url: canonicalUrl,
};
const localBlocks = getLocalCityBlocksForService(service.id).map((block) => {
  const city = cities.find((item) => item.id === block.city);
  if (!city) {
    throw new Error(`[factory-service-money] missing city model for block "${block.city}"`);
  }
  return { ...block, cityModel: city };
});
const cityNameById = new Map(cities.map((city) => [city.id, city.name]));
const cityNameInByName = new Map(cities.map((city) => [city.name, city.nameIn || city.name]));
const geoAnchorLinks = localBlocks.map((block) => ({
  href: buildCityPath(block.cityModel.id),
  label: `${block.cityModel.name} — ${service.name}`,
}));
const serviceAreas = cities.map((city) => buildAdministrativeArea(city.name));

function buildGeoMentionText(block: LocalCityBlock & { cityModel: (typeof cities)[number] }): string {
  const [primaryCase, secondaryCase] = block.cases;
  const firstLocalSignal = primaryCase?.district || primaryCase?.location || block.cityModel.name;
  const secondLocalSignal =
    secondaryCase?.district || secondaryCase?.location || block.reviews[0]?.location || block.cityModel.name;

  return `${currentServiceName} в ${block.cityModel.nameIn || block.cityModel.name} чаще всего заказывают для адресов и районов вроде ${firstLocalSignal} и ${secondLocalSignal}. По ${block.cityModel.nameGenitive || block.cityModel.name} держим выезд на замер за ${block.sla.measurementDays} дн., производство около ${block.sla.productionDays} дн. и монтаж за ${block.sla.installationDays} дн. В отзывах по ${block.cityModel.nameGenitive || block.cityModel.name} чаще отмечают понятную смету, аккуратный монтаж и отсутствие лишних выездов после сдачи.`;
}

const allProjects = (await getCollection('projects'))
  .filter((entry) => {
    if (entry.data.draft) return false;
    const primaryService = normalizeToken(entry.data.service);
    const relatedServices = (entry.data.relatedServices ?? []).map((value) => normalizeToken(value));
    return primaryService === serviceToken || relatedServices.includes(serviceToken);
  })
  .sort((a, b) => {
    const diff = Number(new Date(b.data.publishDate || 0)) - Number(new Date(a.data.publishDate || 0));
    if (diff !== 0) return diff;
    return resolveProjectSlugFromAdapter(a).localeCompare(resolveProjectSlugFromAdapter(b));
  });
const totalProjects = allProjects.length;
const primaryServiceProjects = allProjects.filter((project) => normalizeToken(project.data.service) === serviceToken);
const pricedPrimaryServiceProjects = primaryServiceProjects.filter((project) =>
  Number.isFinite(Number(project.data.price))
);
const priceProofSourceProjects = pricedPrimaryServiceProjects.length >= 3 ? pricedPrimaryServiceProjects : [];
const exactPriceProofCases = buildPriceProofCaseCards(priceProofSourceProjects);
const hybridPriceProofCases =
  service.id === 'garderobnye' &&
  exactPriceProofCases.length === 0 &&
  pricedPrimaryServiceProjects.length >= 1 &&
  primaryServiceProjects.length >= 3
    ? buildHybridPriceProofCaseCards(primaryServiceProjects, localBlocks)
    : [];
const priceProofCases = exactPriceProofCases.length > 0 ? exactPriceProofCases : hybridPriceProofCases;
const hasHybridPriceProof = exactPriceProofCases.length === 0 && hybridPriceProofCases.length > 0;
const priceProofCaseSlugs = new Set(priceProofCases.map((item) => item.slug));
const featuredPrimaryServiceEntries = primaryServiceProjects
  .filter((project) => !priceProofCaseSlugs.has(resolveProjectSlugFromAdapter(project)))
  .slice(0, 6);
const featuredFallbackEntries = allProjects
  .filter((project) => !priceProofCaseSlugs.has(resolveProjectSlugFromAdapter(project)))
  .slice(0, 6);
const featuredProjectEntries =
  featuredPrimaryServiceEntries.length > 0 ? featuredPrimaryServiceEntries : featuredFallbackEntries;
const serviceForms = service.forms;
const serviceContextLabel = serviceForms.genitive || service.name.toLowerCase();
const minMeasurementDays = Math.min(...localBlocks.map((block) => block.sla.measurementDays));
const minProductionDays = Math.min(...localBlocks.map((block) => block.sla.productionDays));
const minInstallationDays = Math.min(...localBlocks.map((block) => block.sla.installationDays));
const minPriceFrom = Math.min(...localBlocks.map((block) => block.priceRange.from));
const priceCurrency = localBlocks[0]?.priceRange.currency || 'RUB';
const totalReviewCount = localBlocks.reduce((sum, block) => sum + block.reviews.length, 0);
const averageReviewRatingRaw =
  totalReviewCount > 0
    ? localBlocks.reduce((sum, block) => sum + block.reviews.reduce((inner, review) => inner + Number(review.rating), 0), 0) /
      totalReviewCount
    : 0;
const averageReviewRating = averageReviewRatingRaw > 0 ? averageReviewRatingRaw.toFixed(1).replace('.0', '') : '';
const totalLocalCases = localBlocks.reduce((sum, block) => sum + block.cases.length, 0);
const priceProofSummary =
  priceProofCases.length > 0
    ? hasHybridPriceProof
      ? `${priceProofCases.length} кейса на странице: один с точной суммой и еще два с подтвержденным диапазоном по городу.`
      : `${priceProofCases.length} кейса на странице с привязкой к реальным итоговым бюджетам.`
    : `${localBlocks.length} городских диапазона по бюджету с привязкой к текущим условиям по городам.`;
const factItems = [
  totalProjects > 0
    ? `В портфолио ${totalProjects} реализованных проектов по теме ${serviceForms.genitive}, из них ${totalLocalCases} кейсов используются в городских блоках на этой странице.`
    : 'На странице используются реальные кейсы и городские ориентиры по услуге.',
  `География и SLA: ${cities.map((city) => city.name).join(', ')}; замер от ${minMeasurementDays} ${formatDaysGenitive(minMeasurementDays)}, производство от ${minProductionDays} ${formatDaysGenitive(minProductionDays)}, монтаж от ${minInstallationDays} ${formatDaysGenitive(minInstallationDays)}.`,
  `Бюджет: старт от ${formatPrice(minPriceFrom, priceCurrency)}. ${priceProofSummary}`,
  totalReviewCount > 0
    ? `Социальное доказательство: ${totalReviewCount} локальных отзывов, средний рейтинг ${averageReviewRating}/5.`
    : 'Социальное доказательство: на странице показаны отзывы клиентов по городам обслуживания.',
];

const allArticles = await getCollection('articles');
const relatedEntities = getRelatedEntities({
  type: 'service',
  slug: page.pageSlug,
  projects: allProjects,
  articles: allArticles,
  limits: { projects: 0, articles: 2, services: 0 },
});
const relatedArticles = relatedEntities.articles;
const resolveArticleSlug = (value: string) => value.replace(/\.mdx?$/, '');

const baseProjects = buildProjectCards(featuredProjectEntries);
const featuredProjectsAreMixed = featuredProjectEntries.some(
  (project) => normalizeToken(project.data.service) !== serviceToken
);
const factsSectionTitle = 'Что можно проверить до заявки';
const processSectionTitle = `Что согласуем до запуска ${serviceForms.genitive}`;
const projectsSectionTitle = featuredProjectsAreMixed
  ? `Наши работы по теме ${serviceForms.genitive}`
  : `Наши работы: ${service.name}`;
const relatedArticlesSectionTitle = `Полезные материалы о ${serviceForms.prepositional}`;
const contactSectionTitle = `Оставить заявку на ${serviceForms.accusative}`;
const serviceAnchorKey = SERVICE_ANCHOR_KEY[service.id] || service.id;
const finalProofItems = FINAL_PROOF_ITEMS[service.id] || [
  'Точный расчет под ваш проект',
  'Несколько вариантов решений и материалов',
  'Понимание бюджета до заказа',
];
const finalProofTitle = FINAL_PROOF_TITLES[service.id] || 'Рассчитаем проект под ваши размеры за 1 день';
const usedServiceAnchors = new Set<string>();
const contextTemplatesByType = {
  exact: ['Пример: {anchor}', 'Кейс — {anchor}'],
  partial: ['Пример: {anchor}', 'Кейс — {anchor}', 'Проект по теме: {anchor}'],
  natural: ['Проект по теме: {anchor}', 'Кейс — {anchor}'],
  generic: ['Подборка: {anchor}', 'Смотреть: {anchor}'],
} as const;
const featuredProjects = baseProjects.map((project, index) => {
  const cityIn = cityNameInByName.get(project.cityLabel) || project.cityLabel;
  const anchorResult = selectServiceAnchor({
    serviceKey: serviceAnchorKey,
    seed: hashString(`${service.id}:${project.slug}:${index}`),
    city: { name: project.cityLabel, in: cityIn },
    usedAnchors: usedServiceAnchors,
    allowedTypes: ['exact', 'partial', 'natural', 'generic'],
    anchorSet: SERVICE_CONTEXT_ANCHORS[serviceAnchorKey],
  });
  if (anchorResult) {
    usedServiceAnchors.add(anchorResult.text);
  }
  const contextTemplatePool = anchorResult
    ? contextTemplatesByType[anchorResult.type] || contextTemplatesByType.partial
    : contextTemplatesByType.partial;
  const contextLabel = anchorResult
    ? contextTemplatePool[index % contextTemplatePool.length].replace('{anchor}', anchorResult.text)
    : `Пример ${serviceContextLabel} в ${cityIn}`;
  return { ...project, contextLabel };
});
const projectPathBySlug = new Map(
  allProjects.map((project) => {
    const slug = resolveProjectSlug(project);
    return [normalizeToken(slug), `/projects/${slug}`];
  })
);

const metadata = {
  title: serviceConfig.seoTitle,
  description: serviceConfig.seoDescription,
  canonical: canonicalPath,
};

const heroTrustItems = (() => {
  if (service.id === 'kuhni-na-zakaz') {
    return [
      'Замер с учетом техники, розеток и вентиляции',
      `В портфолио ${totalProjects} реализованных проектов по теме кухни`,
      'Смета и сроки фиксируются в договоре до запуска',
    ];
  }
  if (service.id === 'shkafy-kupe') {
    return [
      'Замеряем нишу с учетом геометрии стен и пола',
      'Наполнение проектируем под ваш сценарий хранения',
      'Монтаж и регулировка без перекосов и люфтов',
    ];
  }
  if (service.id === 'garderobnye') {
    return [
      'Планируем секции под реальный объем вещей',
      'Материалы и наполнение согласовываем до запуска',
      'Монтаж с проверкой эргономики и доступа к зонам',
    ];
  }
  return [
    `Замер от ${minMeasurementDays} ${formatDaysGenitive(minMeasurementDays)}`,
    `Производство от ${minProductionDays} ${formatDaysGenitive(minProductionDays)}`,
    `Монтаж от ${minInstallationDays} ${formatDaysGenitive(minInstallationDays)}`,
  ];
})();
const heroProjectLabelByService: Record<string, string> = {
  'kuhni-na-zakaz': 'реализованных проектов по теме кухни',
  'shkafy-kupe': 'реализованных проектов по шкафам-купе',
  garderobnye: 'реализованных проектов по гардеробным',
};
const heroMobileProofLabelByService: Record<string, string> = {
  'kuhni-na-zakaz': 'кейсов по кухням',
  'shkafy-kupe': 'кейсов по шкафам',
  garderobnye: 'кейсов по гардеробным',
};
const heroStats = (() => {
  return [
    {
      value: `${totalProjects}`,
      label: heroProjectLabelByService[service.id] || 'реализованных проектов по теме услуги',
    },
    totalReviewCount > 0
      ? { value: `${averageReviewRating}/5`, label: `${totalReviewCount} локальных отзывов` }
      : { value: `${cities.length}`, label: 'города обслуживания' },
    { value: `от ${formatPrice(minPriceFrom, priceCurrency)}`, label: 'старт бюджета по реальным кейсам' },
  ];
})();
const serviceAdvantages = [...serviceConfig.advantages];
const heroPrimaryCtaText = 'Рассчитать стоимость';
const heroSecondaryCtaText = 'Смотреть примеры';
const heroActions = [
  { text: heroPrimaryCtaText, href: '#contact', variant: 'primary' },
  {
    text: heroSecondaryCtaText,
    href: featuredProjects.length > 0 ? '#service-projects' : '#local-city-blocks',
    variant: 'secondary',
  },
];
const heroMobileProof = `${totalProjects} ${heroMobileProofLabelByService[service.id] || 'кейсов по услуге'} • от ${formatPrice(minPriceFrom, priceCurrency)}`;
const priceSectionIntro =
  priceProofCases.length > 0
    ? hasHybridPriceProof
      ? 'Ниже показываем один кейс с точной ценой и еще два реальных проекта с подтвержденными диапазонами по городам.'
      : 'Ниже показываем не абстрактные диапазоны, а реальные проекты из текущего портфолио.'
    : serviceConfig.priceIntro;
const priceSectionEvidence =
  priceProofCases.length > 0
    ? hasHybridPriceProof
      ? 'Точная сумма указана только там, где она есть в карточке проекта. Для остальных кейсов показываем подтвержденный диапазон по соответствующему городу.'
      : 'Каждый ориентир привязан к существующему кейсу и его итоговой стоимости.'
    : serviceConfig.priceEvidence;
const priceSectionNote =
  priceProofCases.length > 0
    ? hasHybridPriceProof
      ? 'Для кейсов без точной цены не подставляем оценку проекта. Вместо этого показываем рабочий диапазон по городу и ведем на реальную страницу кейса.'
      : 'Точный расчет зависит от размеров, планировки, наполнения, материалов и техники. Остальные проекты из портфолио показываем ниже без повторения этих кейсов.'
    : serviceConfig.priceNote;
const projectsSectionDescription =
  priceProofCases.length > 0
    ? 'Ниже — профильные кейсы из портфолио. Кейсы, которые уже использовали для ценовых ориентиров выше, здесь не повторяем.'
    : featuredProjectsAreMixed
      ? 'Ниже — профильные кейсы и смежные системы хранения, которые помогают оценить подход, материалы и сценарии наполнения.'
      : 'Показываем выполненные проекты, которые усиливают основную коммерческую страницу через реальные результаты.';
const midCtaTitle = `Подготовим расчет ${serviceForms.genitive} под ваш бюджет`;
const midCtaSubtitle = 'Без длинного созвона: достаточно фото, примерных размеров и короткого описания задачи.';
const localBusinessOfferCatalog = {
  '@type': 'OfferCatalog',
  name: 'Основные услуги на заказ в Иркутске, Ангарске и Шелехове',
  itemListElement: getMoneyServices().map((moneyService) => ({
    '@type': 'Service',
    name: moneyService.name,
    serviceType: moneyService.name,
    url: toAbsoluteUrl(buildServicePath(moneyService.id), Astro.site),
    areaServed: serviceAreas,
  })),
};

const faqSchema =
  Array.isArray(page.faq) && page.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: page.faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.a,
          },
        })),
      }
    : null;

const leadContext = {
  city: 'irkutsk',
  service: service.id,
  pageType: 'service-money',
  pageSlug: page.pageSlug,
};
---

<PageLayout metadata={metadata} localBusinessOfferCatalog={localBusinessOfferCatalog} pageType="service-money">
  <JsonLd schema={serviceSchema} />
  <Breadcrumb items={[{ label: service.name, href: canonicalPath }]} />

  <HeroModern
    title={serviceConfig.title}
    subtitle={serviceConfig.subtitle}
    actions={heroActions}
    primaryCtaId="service_hero_primary"
    secondaryCtaIds={['service_hero_secondary']}
    mobileProof={heroMobileProof}
    badge={serviceConfig.heroBadge}
    trustItems={heroTrustItems}
    stats={heroStats}
    slides={[
      {
        src: '/images/figma/hero-main.png',
        alt: serviceConfig.title,
        title: serviceConfig.title,
        subtitle: serviceConfig.subtitle,
        kicker: 'Иркутск, Ангарск, Шелехов',
      },
    ]}
  />

  <section class="section section-inner cv-auto facts-block">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ОПОРНЫЕ ДАННЫЕ</div>
      <h2>{factsSectionTitle}</h2>
    </div>
    <ul class="facts-list">
      {factItems.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  {
    service.id === 'kuhni-na-zakaz' && (
      <section class="section section-inner cv-auto">
        <div class="money-head ds-section-head left">
          <div class="money-pill ds-pill">ЭКСПЕРТНЫЙ ПОДХОД</div>
          <h2>Почему выбираем именно такую конфигурацию кухни</h2>
        </div>
        <ul class="facts-list">
          <li>Сначала фиксируем рабочий треугольник, потом подбираем фасады и комплектацию.</li>
          <li>Если есть газ и вентканал, трассы и отступы проектируем до выбора корпуса.</li>
          <li>При ограниченном бюджете сохраняем эргономику и фурнитуру, а материал оптимизируем последним шагом.</li>
        </ul>
      </section>
    )
  }

  {
    serviceConfig.priceRanges && serviceConfig.priceRanges.length > 0 && (
      <section id="service-price" class="section section-inner cv-auto price-block">
        <div class="money-head ds-section-head left">
          <div class="money-pill ds-pill">ОРИЕНТИР ПО БЮДЖЕТУ</div>
          <h2>{serviceConfig.priceTitle || `Сколько стоит ${serviceForms.nominative}?`}</h2>
          {priceSectionIntro && <p>{priceSectionIntro}</p>}
          {priceSectionEvidence && <p class="price-evidence">{priceSectionEvidence}</p>}
        </div>
        {priceProofCases.length > 0 ? (
          <div class="price-grid price-grid--case">
            {priceProofCases.map((item) => (
              <article class="price-card price-card--case ds-card">
                <p class="price-card-kicker">{item.label}</p>
                <strong>{item.title}</strong>
                {item.meta && <p class="price-card-meta">{item.meta}</p>}
                {item.locationLabel && <p class="price-card-location">{item.locationLabel}</p>}
                {item.summary && <p class="price-card-summary">{item.summary}</p>}
                <div class="price-card-value">{item.priceLabel}</div>
                {item.note && <p class="price-card-note">{item.note}</p>}
                <a href={item.href} class="price-card-link" data-anchor-spam="ignore">
                  Смотреть кейс
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="price-grid">
            {serviceConfig.priceRanges.map((item) => (
              <div class="price-card ds-card">
                <strong>{item.label}</strong>
                <span class="price-card-value">{item.value}</span>
              </div>
            ))}
          </div>
        )}
        {priceSectionNote && <p class="price-note">{priceSectionNote}</p>}
        {featuredProjects.length > 0 && (
          <a class="price-next" href="#service-projects">
            {priceProofCases.length > 0
              ? `↓ Еще проекты по теме ${serviceForms.genitive} без повторения кейсов`
              : '↓ Примеры реализованных проектов с ценами'}
          </a>
        )}
      </section>
    )
  }

  <MoneyPageReentryCta title={midCtaTitle} subtitle={midCtaSubtitle} />

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ЧТО ВХОДИТ В ПРОЕКТ</div>
      <h2>{service.name}: от замера до монтажа</h2>
    </div>
    <div class="money-intro" data-main-copy>
      {serviceConfig.overview.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section section-inner geo-anchor-block cv-auto" data-support-links>
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ГОРОДА ОБСЛУЖИВАНИЯ</div>
      <h2>Работаем в городах</h2>
      <p>
        Если удобнее ориентироваться по городу, используйте быстрые переходы. На каждой странице услуг сохраняем единый
        стандарт замера, производства и монтажа.
      </p>
    </div>
    <ul class="geo-anchor-list">
      {
        geoAnchorLinks.map((item) => (
          <li>
            <a href={item.href} class="geo-anchor-link">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ДО ЗАПУСКА ПРОЕКТА</div>
      <h2>{processSectionTitle}</h2>
      <p>До договора фиксируем состав проекта, материалы, бюджет и сроки, чтобы запуск шел без пересборки сметы.</p>
    </div>
    <ul class="money-checklist" aria-label="Что включено">
      {serviceConfig.checklist.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <div class="cv-auto">
    <Advantages items={serviceAdvantages} />
  </div>

  <section id="local-city-blocks" class="section section-inner cv-auto-xl">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">УСЛОВИЯ ПО ГОРОДАМ</div>
      <h2>Иркутск, Ангарск, Шелехов</h2>
      <p>
        Для каждого города показываем реальные кейсы, отзывы клиентов, ориентиры по бюджету и сроки выполнения работ.
      </p>
    </div>

    <div class="city-blocks-grid">
      {
        localBlocks.map((block) => (
          <article class="city-block ds-card" data-local-city-block={block.city}>
            <header class="city-block-head">
              <div>
                <p class="city-block-kicker">{block.cityModel.name}</p>
                <h3>
                  {service.name} в {block.cityModel.nameIn || block.cityModel.name}
                </h3>
              </div>
              <a href="#contact" class="city-block-cta ui-btn-state">
                Получить расчет
              </a>
            </header>

            <p class="city-block-description">{block.offer.description}</p>
            <p class="city-block-geo-mention" data-geo-mention-layer>
              {buildGeoMentionText(block)}
            </p>

            <dl class="city-block-stats">
              <div>
                <dt>Бюджет</dt>
                <dd>
                  {formatPrice(block.priceRange.from, block.priceRange.currency)} -{` `}
                  {formatPrice(block.priceRange.to, block.priceRange.currency)}
                </dd>
              </div>
              <div>
                <dt>SLA</dt>
                <dd>
                  Замер {block.sla.measurementDays} дн. / Производство {block.sla.productionDays} дн. / Монтаж{' '}
                  {block.sla.installationDays} дн.
                </dd>
              </div>
            </dl>

            <p class="city-block-note">
              {block.priceRange.note} {block.sla.note}
            </p>

            <div class="city-block-subsection">
              <h4>Кейсы по городу</h4>
              <ul class="city-case-list">
                {block.cases.map((item) => {
                  const projectHref = item.projectSlug ? projectPathBySlug.get(normalizeToken(item.projectSlug)) : '';
                  const caseCityName = cityNameById.get(item.city) || item.city;
                  return (
                    <li class="city-case-item">
                      <div class="city-case-media">
                        <Image
                          class="city-case-preview"
                          src={item.image}
                          alt={item.alt}
                          width={960}
                          height={720}
                          layout="responsive"
                        />
                        <div class="city-case-gallery" aria-label={`Фото проекта: ${item.title}`}>
                          {item.photos.map((photo, photoIndex) => (
                            <Image
                              src={photo}
                              alt={`${item.alt}, фото ${photoIndex + 1}`}
                              width={480}
                              height={360}
                              layout="responsive"
                            />
                          ))}
                        </div>
                      </div>
                      <div class="city-case-meta">
                        <span>{caseCityName}</span>
                        {item.district && <span>{item.district}</span>}
                        <span>{item.year} г.</span>
                        {typeof item.area === 'number' && <span>{formatAreaValue(item.area)}</span>}
                      </div>
                      <strong>{item.title}</strong>
                      <span class="city-case-location">{item.location}</span>
                      <p>{item.summary}</p>
                      {projectHref && (
                        <a href={projectHref} class="city-case-link" data-anchor-spam="ignore">
                          Смотреть кейс
                        </a>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>

            <div class="city-block-subsection">
              <h4>Отзывы клиентов</h4>
              <ul class="city-review-list">
                {block.reviews.map((review) => (
                  <li class="city-review-item">
                    <p>{review.text}</p>
                    <div>
                      <strong>{review.author}</strong>
                      <span>{review.location}</span>
                      <small>Рейтинг: {review.rating}/5</small>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            <div class="city-block-offer">
              <strong>{block.offer.title}</strong>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {
    featuredProjects.length > 0 && (
      <section id="service-projects" class="section section-inner cv-auto" data-service-projects={serviceToken}>
        <div class="money-head ds-section-head left">
          <div class="money-pill ds-pill">РЕАЛЬНЫЕ ПРОЕКТЫ</div>
