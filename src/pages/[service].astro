          {relatedArticles.map((article) => {
            const articleSlug = resolveArticleSlug(article.id);
            const linkTitle = String(article.data.mainKeyword || article.data.title || '').trim();
            return (
              <a href={`/articles/${articleSlug}`} class="ui-btn-state ds-card ds-card-interactive p-6">
