---
import AdminLayout from '~/layouts/AdminLayout.astro';
import AdminSessionBar from '~/components/admin/AdminSessionBar.astro';

export const prerender = false;
---

<AdminLayout title="Lead Metrics Dashboard">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Lead Metrics Dashboard</h1>
    <p class="text-slate-600 mb-6">
      Ежедневный дашборд конверсии. Фокус на `page_view`, `form_opened`, `form_submitted` и CR.
    </p>

    <AdminSessionBar />

    <form id="metrics-filter" class="grid gap-4 md:grid-cols-4 rounded-xl border border-[#e8d8cb] bg-[#f9f4ef] p-4">
      <label class="text-sm font-medium text-slate-700">
        Span
        <select name="span" class="mt-1 block w-full rounded-md border border-[#d9c6b7] px-3 py-2">
          <option value="day">day</option>
          <option value="hour">hour</option>
        </select>
      </label>
      <label class="text-sm font-medium text-slate-700">
        City
        <input
          name="city"
          type="text"
          placeholder="irkutsk"
          class="mt-1 block w-full rounded-md border border-[#d9c6b7] px-3 py-2"
        />
      </label>
      <label class="text-sm font-medium text-slate-700">
        Service
        <select name="service" class="mt-1 block w-full rounded-md border border-[#d9c6b7] px-3 py-2">
          <option value="">all</option>
          <option value="kuhni">kuhni</option>
          <option value="shkafy">shkafy</option>
          <option value="garderobnye">garderobnye</option>
        </select>
      </label>
      <label class="text-sm font-medium text-slate-700">
        Limit
        <input
          name="limit"
          type="number"
          min="1"
          max="100"
          value="20"
          class="mt-1 block w-full rounded-md border border-[#d9c6b7] px-3 py-2"
        />
      </label>
      <button
        id="metrics-submit"
        class="ui-btn-state md:col-span-4 inline-flex w-fit items-center rounded-md bg-[#8b5a3c] px-5 py-2.5 font-semibold text-white hover:bg-[#7f5438]"
        type="submit">Обновить</button
      >
    </form>

    <div
      id="metrics-summary"
      data-state="idle"
      class="mt-6 rounded-xl border border-[#e8d8cb] bg-white p-4 text-sm text-slate-700"
    >
      Введите admin token или используйте allowlisted IP, затем нажмите «Обновить».
    </div>

    <div class="mt-6 overflow-x-auto rounded-xl border border-[#e8d8cb] bg-white">
      <table class="w-full min-w-[760px] text-sm">
        <thead class="bg-[#f8f2ed] text-left text-slate-700">
          <tr>
            <th class="px-4 py-3">Page</th>
            <th class="px-4 py-3">City</th>
            <th class="px-4 py-3">Service</th>
            <th class="px-4 py-3">Views</th>
            <th class="px-4 py-3">Opened</th>
            <th class="px-4 py-3">Submitted</th>
            <th class="px-4 py-3">Opened Rate</th>
            <th class="px-4 py-3">Submit Rate</th>
            <th class="px-4 py-3">CR (S/V)</th>
          </tr>
        </thead>
        <tbody id="metrics-table-body"></tbody>
      </table>
    </div>
  </section>

  <script src="/scripts/admin-metrics.js" defer></script>
</AdminLayout>

