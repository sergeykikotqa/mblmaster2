---
import { getCollection } from 'astro:content';
import Breadcrumb from '~/components/Breadcrumb.astro';
import MoneyPageReentryCta from '~/components/MoneyPageReentryCta.astro';
import ProjectsGrid from '~/components/projects/ProjectsGrid.astro';
import HeroModern from '~/components/widgets/HeroModern.astro';
import Contact from '~/components/widgets/Contact.astro';
import PageLayout from '~/layouts/PageLayout.astro';
import { buildProjectCards } from '~/lib/projects/project-adapters';
import { toCanonical } from '~/lib/url-builder';

const metadata = {
  title: 'Кухня 3 метра на заказ в Иркутске — стоимость и проекты',
  description:
    'Кухня 3 метра на заказ в Иркутске: варианты комплектации, опубликованные проекты и расчёт стоимости под размеры помещения.',
  canonical: toCanonical('/kuhni-3-metra', Astro.site),
};

const sortByPublishDate = (a, b) => {
  const diff = Number(new Date(b.data.publishDate || 0)) - Number(new Date(a.data.publishDate || 0));
  if (diff !== 0) return diff;
  return (a.slug || '').localeCompare(b.slug || '');
};
const allProjects = await getCollection('projects');
const kitchenProjects = allProjects
  .filter((entry) => !entry.data.draft && String(entry.data.service || '') === 'kuhni')
  .sort(sortByPublishDate);
const projectCards = buildProjectCards(kitchenProjects.slice(0, 6));
const totalKitchenProjects = kitchenProjects.length;

const heroActions = [
  { text: 'Рассчитать стоимость', href: '#contact', variant: 'primary' },
  { text: 'Смотреть примеры', href: '#service-projects', variant: 'secondary' },
];
const heroMobileProof =
  totalKitchenProjects > 0
    ? `${totalKitchenProjects} кейсов по кухням • варианты под размер`
    : 'Планировка под размер • уточнение по задаче';
const midCtaTitle = 'Рассчитаем кухню 3 метра под ваш размер';
const midCtaSubtitle = 'Покажем варианты планировки, материалы и удобное наполнение до согласования проекта.';

const leadContext = {
  city: 'irkutsk',
  service: 'kuhni',
  pageType: 'service-money',
  pageSlug: '/kuhni-3-metra',
};
---

<PageLayout metadata={metadata} pageType="service-money">
  <Breadcrumb items={[{ label: 'Кухни на заказ', href: '/kuhni' }, { label: 'Кухня 3 метра' }]} />

  <HeroModern
    title="Кухня 3 метра на заказ в Иркутске"
    subtitle="Спроектируем комплект под размеры помещения, согласуем материалы и рассчитаем стоимость конкретной комплектации."
    actions={heroActions}
    primaryCtaId="service_hero_primary"
    secondaryCtaIds={['service_hero_secondary']}
    mobileProof={heroMobileProof}
    badge="Кухни под размер"
    trustItems={['Проект под реальные размеры', 'Комплектация до старта производства', 'Стоимость фиксируется в смете']}
    stats={[
      { value: '3 м', label: 'длина кухни' },
      { value: 'под задачу', label: 'планировка' },
      { value: 'по замеру', label: 'итоговая стоимость' },
    ]}
    slides={[
      {
        src: '/images/projects/kuhnya-baykalskaya/01.jpg',
        alt: 'Пример кухни на заказ MBL в Иркутске',
        title: 'Кухня на заказ под размеры помещения',
        subtitle: 'Планировка под реальные размеры и тип помещения.',
        kicker: 'Иркутск',
      },
    ]}
  />

  <section id="price-quick" class="section section-inner cv-auto price-block">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">БЫСТРЫЙ ОТВЕТ</div>
      <h2>Как формируется стоимость кухни 3 метра?</h2>
      <p>Точная цена зависит от материалов, глубины, количества техники и логики хранения. Сначала разбираем планировку, потом фиксируем бюджет по вашему проекту.</p>
    </div>
    <div class="price-grid">
      <div class="price-card ds-card">
        <strong>Материалы</strong>
        <span>ЛДСП, МДФ, фасады и столешница</span>
      </div>
      <div class="price-card ds-card">
        <strong>Наполнение</strong>
        <span>ящики, ширина модулей, хранение</span>
      </div>
      <div class="price-card ds-card">
        <strong>Техника</strong>
        <span>встраиваемая и хозяйственная</span>
      </div>
    </div>
  </section>

  <section id="service-projects" class="section section-inner cv-auto" data-service-projects="kuhni-3-metra">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">РЕАЛЬНЫЕ ПРОЕКТЫ</div>
      <h2>Примеры наших кухонь для компактных помещений</h2>
      <p>В подборке показаны опубликованные кухонные проекты MBL. Их точная длина не заявляется как 3 метра без подтверждённых данных конкретного проекта.</p>
    </div>
    <ul class="example-list">
      <li>Сравните материалы, конфигурацию и состав хранения в реальных проектах.</li>
      <li>Стоимость каждого нового заказа рассчитывается под его размеры и комплектацию.</li>
    </ul>
    {projectCards.length > 0 && (
      <div class="mt-6">
        <ProjectsGrid projects={projectCards} />
      </div>
    )}
  </section>

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ЦЕНЫ</div>
      <h2>Как понять реальный бюджет кухни 3 метра</h2>
      <p>Точная стоимость зависит от размеров, выбора материалов, техники и логики хранения.</p>
    </div>
    <ul class="compact-list">
      <li>Базовый проект обычно обходится дешевле, если нужна простая и компактная конфигурация.</li>
      <li>Угловые модули, встроенная техника и подсветка повышают стоимость и усложняют проект.</li>
      <li>Окончательный бюджет формируется после замера и согласования наполнения.</li>
    </ul>
    <div class="price-extra">
      <div>
        <strong>Что входит:</strong>
        <p>корпуса, фасады, фурнитура, проект, монтаж.</p>
      </div>
      <div>
        <strong>От чего зависит цена:</strong>
        <p>материалы, размер, техника, глубина и высота мебели.</p>
      </div>
    </div>
    <p class="section-note">Подходы и ориентиры обсуждаем на замере, без подмены фактической цены проекта обобщённым «средним диапазоном».</p>
    <a class="price-next" href="/articles/planirovka-kuhni-3-metra-irkutsk">Как спланировать кухню длиной 3 метра →</a>
  </section>

  <MoneyPageReentryCta title={midCtaTitle} subtitle={midCtaSubtitle} />

  <section class="section section-inner cv-auto trust-mini">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ДОВЕРИЕ</div>
      <h2>Расчёт опирается на замер и согласованную комплектацию</h2>
      <p>Не называем обычный кухонный проект трёхметровым без подтверждённой длины. Состав и стоимость фиксируем до запуска производства.</p>
    </div>
  </section>

  <section class="section section-inner cv-auto final-proof">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ПЕРЕД ЗАЯВКОЙ</div>
      <h2>Рассчитаем кухню 3 метра под вашу планировку</h2>
      <p>Подойдёт, даже если вы пока просто сравниваете варианты.</p>
    </div>
    <ul class="final-proof-list">
      <li>Подготовим вариант планировки под реальные размеры.</li>
      <li>Подберём материалы под бюджет.</li>
      <li>Рассчитаем стоимость согласованной комплектации.</li>
    </ul>
    <p class="final-proof-note">Можно оставить заявку без звонка; свяжемся для уточнения деталей.</p>
  </section>

  <div class="cv-auto">
    <Contact
      id="contact"
      title="Оставить заявку на кухню 3 метра"
      subtitle="Опишите задачу — покажем, как лучше распределить модули и что понадобится для вашего пространства."
      tagline="Форма расчета"
      inputs={[
        { type: 'text', name: 'name', label: 'Имя', required: true },
        { type: 'tel', name: 'phone', label: 'Телефон', required: true },
        { type: 'textarea', name: 'message', label: 'Комментарий по проекту', required: false },
      ]}
      leadContext={leadContext}
    />
  </div>
</PageLayout>

<style is:inline>
  .price-block {
    border: 1px solid #eaded4;
    border-radius: 1rem;
    background: #fcfaf8;
  }
  .price-grid {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .price-card {
    padding: 0.85rem;
    border-radius: 0.9rem;
    background: linear-gradient(180deg, #fdf8f3 0%, #f7eee5 100%);
    border: 1px solid #eaded4;
    display: grid;
    gap: 0.35rem;
  }
  .price-card strong {
    color: #3b2f28;
    font-size: 0.92rem;
  }
  .price-card span {
    color: #7f5438;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .price-extra {
    margin-top: 0.8rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .price-extra strong {
    display: block;
    color: #3b2f28;
    margin-bottom: 0.25rem;
  }
  .price-next {
    margin-top: 0.7rem;
    display: inline-flex;
    align-items: center;
    color: #7f5438;
    font-weight: 700;
    text-decoration: none;
  }
  .price-next:hover {
    text-decoration: underline;
  }
  .compact-list {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
    max-width: var(--content);
  }
  .compact-list li {
    border-radius: 0.7rem;
    border: 1px solid #eaded4;
    background: #fff;
    padding: 0.6rem 0.75rem;
    color: #4b4039;
    font-weight: 600;
  }
  .layout-grid {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }
  .layout-card {
    padding: 0.9rem;
  }
  .layout-card h3 {
    margin: 0;
    color: #1f1a17;
  }
  .layout-card p {
    margin: 0.4rem 0 0;
    color: #5d544d;
    line-height: 1.6;
  }
  .section-note {
    margin-top: 0.6rem;
    color: #6d625b;
    line-height: 1.6;
    max-width: var(--content);
  }
  .example-list {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .example-list li {
    border-radius: 0.75rem;
    border: 1px solid #eaded4;
    background: #fff;
    padding: 0.65rem 0.8rem;
    font-weight: 700;
    color: #5c524b;
  }
  .trust-mini {
    border: 1px solid #eaded4;
    border-radius: 1rem;
    background: #fff;
  }
  .final-proof {
    border: 1px solid #eaded4;
    border-radius: 1rem;
    background: linear-gradient(180deg, #fff 0%, #fbf6f2 100%);
    padding: 1rem;
  }
  .final-proof-list {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    max-width: var(--content);
  }
  .final-proof-list li {
    border-radius: 0.75rem;
    border: 1px solid #eaded4;
    background: #fff;
    padding: 0.6rem 0.75rem;
    color: #4b4039;
    font-weight: 600;
  }
  .final-proof-note {
    margin: 0.75rem 0 0;
    color: #6d625b;
  }
  @media (max-width: 960px) {
    .price-grid,
    .price-extra,
    .layout-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

