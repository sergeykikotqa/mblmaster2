---
import { getCollection } from 'astro:content';
import Breadcrumb from '~/components/Breadcrumb.astro';
import MoneyPageReentryCta from '~/components/MoneyPageReentryCta.astro';
import ProjectsGrid from '~/components/projects/ProjectsGrid.astro';
import HeroModern from '~/components/widgets/HeroModern.astro';
import Contact from '~/components/widgets/Contact.astro';
import PageLayout from '~/layouts/PageLayout.astro';
import { buildProjectCards } from '~/lib/projects/project-adapters';
import { toCanonical } from '~/lib/url-builder';

const metadata = {
  title: 'Кухня 3 метра на заказ в Иркутске — цена, планировки, примеры',
  description:
    'Кухня 3 метра на заказ в Иркутске: планировка, что помещается, примеры и ориентир по цене. Рассчитаем планировку и стоимость за 1 день.',
  canonical: toCanonical('/kuhni-3-metra', Astro.site),
};

const sortByPublishDate = (a, b) => {
  const diff = Number(new Date(b.data.publishDate || 0)) - Number(new Date(a.data.publishDate || 0));
  if (diff !== 0) return diff;
  return (a.slug || '').localeCompare(b.slug || '');
};
const allProjects = await getCollection('projects');
const kitchenProjects = allProjects
  .filter((entry) => !entry.data.draft && String(entry.data.service || '') === 'kuhni')
  .sort(sortByPublishDate);
const projectCards = buildProjectCards(kitchenProjects.slice(0, 6));
const totalKitchenProjects = kitchenProjects.length;

const heroActions = [
  { text: 'Рассчитать стоимость', href: '#contact', variant: 'primary' },
  { text: 'Смотреть примеры', href: '#service-projects', variant: 'secondary' },
];
const heroMobileProof =
  totalKitchenProjects > 0
    ? `${totalKitchenProjects} кейсов по кухням • от 120 000 ₽`
    : 'Планировка за 1 день • от 120 000 ₽';
const midCtaTitle = 'Рассчитаем кухню 3 метра под ваш размер за 1 день';
const midCtaSubtitle = 'Покажем 2–3 варианта планировки, материалы и реальный бюджет до заказа.';

const leadContext = {
  city: 'irkutsk',
  service: 'kuhni',
  pageType: 'service-money',
  pageSlug: '/kuhni-3-metra',
};
---

<PageLayout metadata={metadata} pageType="service-money">
  <Breadcrumb items={[{ label: 'Кухни на заказ', href: '/kuhni' }, { label: 'Кухня 3 метра' }]} />

  <HeroModern
    title="Кухня 3 метра на заказ в Иркутске"
    subtitle="Оптимальная планировка для небольших помещений. Рассчитаем стоимость и покажем варианты за 1 день."
    actions={heroActions}
    primaryCtaId="service_hero_primary"
    secondaryCtaIds={['service_hero_secondary']}
    mobileProof={heroMobileProof}
    badge="Кухни под размер"
    trustItems={['Уместим технику даже на 3 метрах', 'Проект до старта производства', 'Цена фиксируется в договоре']}
    stats={[
      { value: '3 м', label: 'длина кухни' },
      { value: '1 день', label: 'расчет и планировка' },
      { value: 'от 120 тыс. ₽', label: 'базовый бюджет' },
    ]}
    slides={[
      {
        src: '/images/projects/kuhnya-baykalskaya/01.jpg',
        alt: 'Кухня 3 метра на заказ',
        title: 'Кухня 3 метра на заказ в Иркутске',
        subtitle: 'Оптимальная планировка и расчет за 1 день.',
        kicker: 'Иркутск, Ангарск, Шелехов',
      },
    ]}
  />

  <section id="price-quick" class="section section-inner cv-auto price-block">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">БЫСТРЫЙ ОТВЕТ</div>
      <h2>Сколько стоит кухня 3 метра?</h2>
      <p>Ориентиры по бюджету для небольших помещений.</p>
    </div>
    <div class="price-grid">
      <div class="price-card ds-card">
        <strong>Базовая</strong>
        <span>от 120 000 ₽</span>
      </div>
      <div class="price-card ds-card">
        <strong>Средний сегмент</strong>
        <span>150 000 – 250 000 ₽</span>
      </div>
      <div class="price-card ds-card">
        <strong>С техникой</strong>
        <span>от 250 000 ₽</span>
      </div>
    </div>
  </section>

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">КАКОЙ ДОЛЖНА БЫТЬ</div>
      <h2>Какой должна быть кухня 3 метра</h2>
      <p>Чтобы кухня была удобной, важно не площадь, а планировка и хранение.</p>
    </div>
    <ul class="compact-list">
      <li>Прямая или угловая планировка — без лишних поворотов.</li>
      <li>Встроенная техника и узкие модули вместо громоздких шкафов.</li>
      <li>Хранение до потолка, чтобы использовать вертикаль.</li>
      <li>Минимум лишних декоративных элементов.</li>
    </ul>
  </section>

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ПЛАНИРОВКА</div>
      <h2>Планировка кухни 3 метра</h2>
    </div>
    <div class="layout-grid">
      <div class="layout-card ds-card">
        <h3>Прямая кухня</h3>
        <p>Подходит для узкого помещения. Минимум затрат, но меньше рабочей поверхности.</p>
      </div>
      <div class="layout-card ds-card">
        <h3>Угловая кухня</h3>
        <p>Самый удобный вариант: больше хранения и правильный рабочий треугольник.</p>
      </div>
    </div>
  </section>

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">СРАВНЕНИЕ</div>
      <h2>Кухня 3 метра: прямая или угловая — что лучше</h2>
      <p>Если есть хотя бы один угол — угловая обычно удобнее и дает больше хранения.</p>
    </div>
    <ul class="compact-list">
      <li>Прямая — если кухня узкая и нет возможности развернуться.</li>
      <li>Угловая — если нужно больше хранения и рабочей поверхности.</li>
    </ul>
    <p class="section-note">В большинстве случаев для кухни 3 метра выбирают угловую планировку.</p>
  </section>

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ПОЯСНЕНИЕ</div>
      <h2>Кухня 3 метра: сколько это в реальности</h2>
    </div>
    <ul class="compact-list">
      <li>3 метра — это небольшая кухня в квартире.</li>
      <li>Чаще всего это 5–7 м².</li>
      <li>Требуется продуманная планировка и хранение.</li>
    </ul>
  </section>

  <section id="service-projects" class="section section-inner cv-auto" data-service-projects="kuhni-3-metra">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">РЕАЛЬНЫЕ ПРОЕКТЫ</div>
      <h2>Наши работы: кухни 3 метра</h2>
      <p>Формат «м² + результат + цена» — ориентир для понимания бюджета.</p>
    </div>
    <ul class="example-list">
      <li>5,4 м² • хрущёвка • семья из 2 человек → вместили духовку и ПММ → ориентир 180 000 ₽</li>
      <li>6,1 м² • новостройка • семья из 3 человек → увеличили хранение на 40% → ориентир 210 000 ₽</li>
    </ul>
    {projectCards.length > 0 && (
      <div class="mt-6">
        <ProjectsGrid projects={projectCards} />
      </div>
    )}
  </section>

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ЧТО ПОМЕСТИТСЯ</div>
      <h2>Кухня 3 метра с техникой: что учитывать</h2>
      <p>При правильной планировке можно разместить технику и сохранить удобные проходы.</p>
    </div>
    <ul class="compact-list">
      <li>Встраиваемую технику лучше закладывать в проект заранее.</li>
      <li>Посудомойка 45 см и духовка обычно помещаются без потери хранения.</li>
      <li>Для вытяжки нужно предусмотреть место и выводы заранее.</li>
    </ul>
  </section>

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ЧТО ПОМЕСТИТСЯ</div>
      <h2>Что можно разместить в кухне 3 метра</h2>
    </div>
    <ul class="compact-list">
      <li>Варочная панель на 2–4 конфорки.</li>
      <li>Духовка.</li>
      <li>Посудомойка 45 см.</li>
      <li>Холодильник у торца или в нише.</li>
    </ul>
    <p class="section-note">При правильной планировке можно добавить микроволновку и дополнительное хранение.</p>
  </section>

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ОШИБКИ</div>
      <h2>Ошибки при планировании кухни 3 метра</h2>
    </div>
    <ul class="compact-list">
      <li>Ставят слишком много шкафов — кухня становится тесной и неудобной.</li>
      <li>Не учитывают технику — в итоге она не помещается.</li>
      <li>Выбирают тёмные фасады — пространство визуально уменьшается.</li>
      <li>Не делают проект заранее — теряют до 20–30% пространства.</li>
    </ul>
  </section>

  <section class="section section-inner cv-auto">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ЦЕНЫ</div>
      <h2>Сколько стоит кухня 3 метра в Иркутске</h2>
      <p>Цена зависит от материалов, комплектации и техники.</p>
    </div>
    <ul class="compact-list">
      <li>До 150 000 ₽ — ЛДСП, базовая фурнитура.</li>
      <li>150–250 тыс. ₽ — МДФ, доводчики, более удобная система хранения.</li>
      <li>От 250 тыс. ₽ — эмаль/шпон, сложные решения и техника.</li>
    </ul>
    <div class="price-extra">
      <div>
        <strong>Что входит:</strong>
        <p>корпуса, фасады, фурнитура.</p>
      </div>
      <div>
        <strong>От чего зависит цена:</strong>
        <p>материалы, размер, техника.</p>
      </div>
    </div>
    <p class="section-note">Точный расчет зависит от планировки — покажем ниже на примерах.</p>
    <a class="price-next" href="/articles/skolko-stoit-kuhnya-v-irkutske">Сколько стоит кухня →</a>
  </section>

  <MoneyPageReentryCta title={midCtaTitle} subtitle={midCtaSubtitle} />

  <section class="section section-inner cv-auto trust-mini">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ДОВЕРИЕ</div>
      <h2>Регулярно делаем кухни длиной около 3 метров — это один из самых частых форматов</h2>
      <p>Разбираем планировки и цены, работаем по договору и фиксируем стоимость до запуска производства.</p>
    </div>
  </section>

  <section class="section section-inner cv-auto final-proof">
    <div class="money-head ds-section-head left">
      <div class="money-pill ds-pill">ПЕРЕД ЗАЯВКОЙ</div>
      <h2>Рассчитаем кухню 3 метра под вашу планировку</h2>
      <p>Подойдёт, даже если вы пока просто сравниваете варианты.</p>
    </div>
    <ul class="final-proof-list">
      <li>Предложим 2–3 варианта планировки.</li>
      <li>Подберём материалы под бюджет.</li>
      <li>Сразу скажем стоимость.</li>
    </ul>
    <p class="final-proof-note">Можно оставить заявку без звонка; свяжемся для уточнения деталей.</p>
  </section>

  <div class="cv-auto">
    <Contact
      id="contact"
      title="Оставить заявку на кухню 3 метра"
      subtitle="Опишите задачу — рассчитаем планировку и стоимость за 1 день."
      tagline="Форма расчета"
      inputs={[
        { type: 'text', name: 'name', label: 'Имя', required: true },
        { type: 'tel', name: 'phone', label: 'Телефон', required: true },
        { type: 'textarea', name: 'message', label: 'Комментарий по проекту', required: false },
      ]}
      leadContext={leadContext}
    />
  </div>
</PageLayout>

<style is:inline>
  .price-block {
    border: 1px solid #eaded4;
    border-radius: 1rem;
    background: #fcfaf8;
  }
  .price-grid {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .price-card {
    padding: 0.85rem;
    border-radius: 0.9rem;
    background: linear-gradient(180deg, #fdf8f3 0%, #f7eee5 100%);
    border: 1px solid #eaded4;
    display: grid;
    gap: 0.35rem;
  }
  .price-card strong {
    color: #3b2f28;
    font-size: 0.92rem;
  }
  .price-card span {
    color: #7f5438;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .price-extra {
    margin-top: 0.8rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .price-extra strong {
    display: block;
    color: #3b2f28;
    margin-bottom: 0.25rem;
  }
  .price-next {
    margin-top: 0.7rem;
    display: inline-flex;
    align-items: center;
    color: #7f5438;
    font-weight: 700;
    text-decoration: none;
  }
  .price-next:hover {
    text-decoration: underline;
  }
  .compact-list {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
    max-width: var(--content);
  }
  .compact-list li {
    border-radius: 0.7rem;
    border: 1px solid #eaded4;
    background: #fff;
    padding: 0.6rem 0.75rem;
    color: #4b4039;
    font-weight: 600;
  }
  .layout-grid {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }
  .layout-card {
    padding: 0.9rem;
  }
  .layout-card h3 {
    margin: 0;
    color: #1f1a17;
  }
  .layout-card p {
    margin: 0.4rem 0 0;
    color: #5d544d;
    line-height: 1.6;
  }
  .section-note {
    margin-top: 0.6rem;
    color: #6d625b;
    line-height: 1.6;
    max-width: var(--content);
  }
  .example-list {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .example-list li {
    border-radius: 0.75rem;
    border: 1px solid #eaded4;
    background: #fff;
    padding: 0.65rem 0.8rem;
    font-weight: 700;
    color: #5c524b;
  }
  .trust-mini {
    border: 1px solid #eaded4;
    border-radius: 1rem;
    background: #fff;
  }
  .final-proof {
    border: 1px solid #eaded4;
    border-radius: 1rem;
    background: linear-gradient(180deg, #fff 0%, #fbf6f2 100%);
    padding: 1rem;
  }
  .final-proof-list {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    max-width: var(--content);
  }
  .final-proof-list li {
    border-radius: 0.75rem;
    border: 1px solid #eaded4;
    background: #fff;
    padding: 0.6rem 0.75rem;
    color: #4b4039;
    font-weight: 600;
  }
  .final-proof-note {
    margin: 0.75rem 0 0;
    color: #6d625b;
  }
  @media (max-width: 960px) {
    .price-grid,
    .price-extra,
    .layout-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

