---
// Floating call button for mobile/tablet (desktop uses header CTAs)
import { getBusinessInfo } from '~/config/business-info';

const businessInfo = getBusinessInfo();
const phoneHref = `tel:${businessInfo.phoneHref}`;
---

<div id="floating-call-button" class="group fixed bottom-6 right-6 z-40">
  <a
    href={phoneHref}
    data-cta-placement="floating"
    data-cta="floating_phone"
    data-cta-type="phone"
    class="ui-btn-state flex h-16 w-16 items-center justify-center rounded-full bg-[#8b5a3c] text-white shadow-2xl shadow-[#8b5c3d]/35 transition-all duration-300 hover:scale-105 hover:bg-[#7f5438]"
    aria-label="Позвонить"
    title={`Позвонить ${businessInfo.phone}`}
  >
    <svg
      class="h-7 w-7 transition-transform duration-300 group-hover:scale-110"
      fill="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
      ></path>
    </svg>
  </a>

  <!-- Tooltip -->
  <div
    class="pointer-events-none absolute bottom-20 right-0 max-w-[calc(100vw-2rem)] whitespace-normal rounded-lg bg-slate-900 px-4 py-3 text-sm font-semibold text-white opacity-0 transition-all duration-300 group-hover:opacity-100"
  >
    <div>{businessInfo.phone}</div>
    <div class="text-xs text-[#d8bea9]">{businessInfo.openingHoursText}</div>
  </div>
</div>

<style is:inline>
  @media (min-width: 1024px) {
    #floating-call-button {
      display: none;
    }
  }

  @media (max-width: 640px) {
    #floating-call-button {
      bottom: 20px !important;
      right: 20px !important;
    }
  }
</style>

