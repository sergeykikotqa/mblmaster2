---
import type { Headline as Props } from '~/types';
import { twMerge } from 'tailwind-merge';

const { title = '', subtitle = '', tagline = '', classes = {} } = Astro.props as Props;

const hasTitleSlot = Astro.slots.has('title');
const hasSubtitleSlot = Astro.slots.has('subtitle');
const hasTaglineSlot = Astro.slots.has('tagline');

const {
  container: containerClass = 'max-w-3xl',
  title: titleClass = 'text-3xl md:text-4xl ',
  subtitle: subtitleClass = 'text-xl',
} = classes;
---

{
  (title || subtitle || tagline || hasTitleSlot || hasSubtitleSlot || hasTaglineSlot) && (
    <div class={twMerge('mb-8 md:mx-auto md:mb-12 text-center', containerClass)}>
      {(tagline || hasTaglineSlot) && (
        <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">
          {hasTaglineSlot ? <slot name="tagline" /> : tagline}
        </p>
      )}
      {(title || hasTitleSlot) && (
        <h2 class={twMerge('font-bold leading-tighter tracking-tighter font-heading text-heading text-3xl', titleClass)}>
          {hasTitleSlot ? <slot name="title" /> : title}
        </h2>
      )}

      {(subtitle || hasSubtitleSlot) && (
        <p class={twMerge('mt-4 text-muted', subtitleClass)}>
          {hasSubtitleSlot ? <slot name="subtitle" /> : subtitle}
        </p>
      )}
    </div>
  )
}
