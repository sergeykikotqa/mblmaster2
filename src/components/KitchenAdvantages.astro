---
interface AdvantageItem {
  title: string;
  body?: string;
  desc?: string;
  description?: string;
}

interface Props {
  title?: string;
  items?: AdvantageItem[];
  id?: string;
}

const { title = 'Преимущества наших кухонь', items = [], id } = Astro.props as Props;
---

<section id={id} class="max-w-7xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
  <div class="text-center mb-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-3">{title}</h2>
    <p class="text-slate-600">Практичные решения, долговечные материалы и удобство на каждый день.</p>
  </div>

  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {
      items.map((item, idx) => {
        const text = item.description || item.body || item.desc || '';
        return (
          <li class="rounded-xl border border-[#e8d8cb] bg-white p-6 transition-all hover:border-[#cfab91] hover:shadow-lg">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-[#8b5a3c] text-white font-semibold">
              {idx + 1}
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">{item.title}</h3>
            {text && <p class="text-sm text-slate-600">{text}</p>}
          </li>
        );
      })
    }
  </ul>
</section>

