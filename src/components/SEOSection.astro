---
// Component für SEO-text sections
interface Props {
  title: string;
  className?: string;
}

const { title, className = '' } = Astro.props;
---

<section class={`max-w-4xl mx-auto px-4 py-8 sm:py-12 text-slate-700 ${className}`}>
  <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4">{title}</h2>
  <div class="prose prose-sm max-w-none space-y-3 text-sm sm:text-base leading-relaxed">
    <slot />
  </div>
</section>
