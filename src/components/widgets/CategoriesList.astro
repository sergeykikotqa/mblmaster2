---
export interface Props {
  id?: string;
  class?: string;
}

const { id, class: cls = '' } = Astro.props as Props;

import Image from '~/components/common/Image.astro';

const categories = [
  {
    title: 'Кухни на заказ',
    description: 'Линейные, угловые, с островом и до потолка. Под планировку и ваш сценарий готовки.',
    image: '/images/categories/kuhni.jpg',
    href: '/kuhni',
  },
  {
    title: 'Шкафы-купе',
    description: 'Системы хранения под нишу и во всю стену. Оптимизируем пространство квартиры.',
    image: '/images/categories/shkafy.jpg',
    href: '/shkafy',
  },
  {
    title: 'Гардеробные',
    description: 'Полки, штанги, ящики и подсветка в удобной конфигурации под ваш быт.',
    image: '/images/categories/garderobnye.jpg',
    href: '/garderobnye',
  },
];
---

<section id={id} class={`categories py-10 md:py-14 ${cls}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="categories-head ds-section-head">
      <div class="categories-pill ds-pill">КАТЕГОРИИ</div>
      <h2>Что мы производим</h2>
      <p>Кухни, шкафы-купе и гардеробные по индивидуальным проектам в Иркутске и области.</p>
    </div>

    <div class="categories-grid">
      {
        categories.map((item, idx) => (
          <article class="category-card ds-card ds-card-interactive">
            <Image src={item.image} alt={item.title} width={1200} height={704} layout="cover" />
            <div class="category-overlay" />
            <div class="category-body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a
                href={item.href}
                data-cta-placement="section"
                data-cta={`home_category_${idx + 1}`}
                data-cta-type="secondary"
                class="ui-btn-state category-link"
              >
                Подробнее
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:inline>
  .categories {
    background: #fff;
  }
  .categories-head h2 {
    margin: 0;
    font-size: clamp(1.7rem, 2.8vw, 2.25rem);
    color: #161514;
  }
  .categories-head p {
    margin: 0.65rem auto 0;
    max-width: 42rem;
    color: #665e58;
  }
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .category-card {
    position: relative;
    overflow: hidden;
    min-height: 19rem;
  }
  .category-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }
  .category-card:hover img {
    transform: scale(1.04);
  }
  .category-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(16 14 12 / 18%) 15%, rgb(16 14 12 / 78%) 100%);
  }
  .category-body {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    padding: 1rem;
    color: #fff;
  }
  .category-body h3 {
    margin: 0;
    font-size: 1.2rem;
    color: #fff;
  }
  .category-body p {
    margin: 0.55rem 0 0;
    color: rgb(255 255 255 / 92%);
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .category-link {
    margin-top: 0.75rem;
    display: inline-flex;
    min-height: 2.5rem;
    border-radius: 0.55rem;
    border: 1px solid rgb(255 255 255 / 55%);
    background: rgb(255 255 255 / 14%);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.5rem 0.85rem;
    transition: background-color 0.2s ease;
  }
  .category-link:hover {
    text-decoration: none;
    background: rgb(255 255 255 / 24%);
  }
  @media (max-width: 980px) {
    .categories-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .category-card:last-child {
      grid-column: 1 / -1;
      min-height: 16rem;
    }
  }
  @media (max-width: 640px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
    .category-card:last-child {
      grid-column: auto;
    }
    .category-card {
      min-height: 15rem;
    }
  }
</style>
