---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title,
  subtitle,
  tagline,

  content,
  actions,
  image,

  id,
} = Astro.props;

const hasTitleSlot = Astro.slots.has('title');
const hasSubtitleSlot = Astro.slots.has('subtitle');
const hasTaglineSlot = Astro.slots.has('tagline');
const hasContentSlot = Astro.slots.has('content');
const hasActionsSlot = Astro.slots.has('actions');
const hasImageSlot = Astro.slots.has('image');

const actionsList = Array.isArray(actions) ? actions : null;
const actionsText = typeof actions === 'string' ? actions : null;

const imageAttributes = typeof image === 'object' && image ? (image as Record<string, unknown>) : null;
const imageSrc = typeof image === 'string' ? image : (imageAttributes?.src as string | undefined);
const imageAlt =
  (imageAttributes?.alt as string | undefined) ||
  (typeof title === 'string' && title) ||
  (typeof subtitle === 'string' && subtitle) ||
  'Hero image';
---

<section class="relative md:-mt-[76px] not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg" />
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20 lg:py-0 lg:flex lg:items-center lg:h-screen lg:gap-8">
      <div class="basis-1/2 text-center lg:text-left pb-10 md:pb-16 mx-auto">
        {(tagline || hasTaglineSlot) && (
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
            {hasTaglineSlot ? <slot name="tagline" /> : tagline}
          </p>
        )}
        {(title || hasTitleSlot) && (
          <h1 class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
            {hasTitleSlot ? <slot name="title" /> : title}
          </h1>
        )}
        <div class="max-w-3xl mx-auto lg:max-w-none">
          {(subtitle || hasSubtitleSlot) && (
            <p class="text-xl text-muted mb-6 dark:text-slate-300 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
              {hasSubtitleSlot ? <slot name="subtitle" /> : subtitle}
            </p>
          )}

          {
            (actionsList || hasActionsSlot || actionsText) && (
              <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 lg:justify-start lg:m-0 lg:max-w-7xl intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
                {actionsList ? (
                  actionsList.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : hasActionsSlot ? (
                  <slot name="actions" />
                ) : (
                  <span>{actionsText}</span>
                )}
              </div>
            )
          }
        </div>
        {(content || hasContentSlot) && (hasContentSlot ? <slot name="content" /> : <p>{content}</p>)}
      </div>
      <div class="basis-1/2">
        {
          (image || hasImageSlot) && (
            <div class="relative m-auto max-w-5xl intersect-once intersect-no-queue motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
              {hasImageSlot ? (
                <slot name="image" />
              ) : (
                <Image
                  class="mx-auto rounded-md w-full"
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  fetchpriority="high"
                  width={600}
                  height={600}
                  src={imageSrc}
                  alt={imageAlt}
                  {...(imageAttributes ?? {})}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
