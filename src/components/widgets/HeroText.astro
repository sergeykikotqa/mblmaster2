---
import type { CallToAction } from '~/types';
import Button from '~/components/ui/Button.astro';

export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  content?: string;
  callToAction?: string | CallToAction;
  callToAction2?: string | CallToAction;
}

const {
  title,
  subtitle,
  tagline,
  content,
  callToAction,
  callToAction2,
} = Astro.props;

const hasTitleSlot = Astro.slots.has('title');
const hasSubtitleSlot = Astro.slots.has('subtitle');
const hasTaglineSlot = Astro.slots.has('tagline');
const hasContentSlot = Astro.slots.has('content');
const hasCallToActionSlot = Astro.slots.has('callToAction');
const hasCallToAction2Slot = Astro.slots.has('callToAction2');
---

<section class="relative md:-mt-[76px] not-prose">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20 pb-8 md:pb-8">
      <div class="text-center max-w-5xl mx-auto">
        {(tagline || hasTaglineSlot) && (
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            {hasTaglineSlot ? <slot name="tagline" /> : tagline}
          </p>
        )}
        {(title || hasTitleSlot) && (
          <h1 class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            {hasTitleSlot ? <slot name="title" /> : title}
          </h1>
        )}
        <div class="max-w-3xl mx-auto">
          {(subtitle || hasSubtitleSlot) && (
            <p class="text-xl text-muted mb-6 dark:text-slate-300 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
              {hasSubtitleSlot ? <slot name="subtitle" /> : subtitle}
            </p>
          )}
          <div
            class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          >
            {
              (callToAction || hasCallToActionSlot) && (
                <div class="flex w-full sm:w-auto">
                  {hasCallToActionSlot ? (
                    <slot name="callToAction" />
                  ) : typeof callToAction === 'string' ? (
                    <span>{callToAction}</span>
                  ) : (
                    <Button
                      href={callToAction?.href}
                      variant={callToAction?.variant ?? 'primary'}
                      class="w-full sm:w-auto py-4 px-8 text-lg font-semibold"
                    >
                      {callToAction?.text}
                    </Button>
                  )}
                </div>
              )
            }

            {
              (callToAction2 || hasCallToAction2Slot) && (
                <div class="flex w-full sm:w-auto">
                  {hasCallToAction2Slot ? (
                    <slot name="callToAction2" />
                  ) : typeof callToAction2 === 'string' ? (
                    <span>{callToAction2}</span>
                  ) : (
                    <Button
                      href={callToAction2?.href}
                      variant={callToAction2?.variant ?? 'ghost'}
                      class="w-full sm:w-auto py-3 px-6 text-base font-medium"
                    >
                      {callToAction2?.text}
                    </Button>
                  )}
                </div>
              )
            }
          </div>
        </div>
        {(content || hasContentSlot) && (hasContentSlot ? <slot name="content" /> : <p>{content}</p>)}
      </div>
    </div>
  </div>
</section>
