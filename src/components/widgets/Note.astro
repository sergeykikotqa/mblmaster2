---
import { Icon } from 'astro-icon/components';

export interface Props {
  icon?: string;
  title?: string;
  description?: string;
}

const {
  icon = 'tabler:info-square',
  title,
  description,
} = Astro.props;

const hasTitleSlot = Astro.slots.has('title');
const hasDescriptionSlot = Astro.slots.has('description');
---

<section class="bg-blue-50 dark:bg-slate-800 not-prose">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 text-md text-center font-medium">
    <Icon name={icon} class="w-5 h-5 inline-block align-text-bottom font-bold" />
    {(title || hasTitleSlot) && (
      <span class="font-bold">{hasTitleSlot ? <slot name="title" /> : title}</span>
    )}
    {(description || hasDescriptionSlot) && (
      <span class="ml-2">{hasDescriptionSlot ? <slot name="description" /> : description}</span>
    )}
  </div>
</section>
