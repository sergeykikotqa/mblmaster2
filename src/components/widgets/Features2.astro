---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ItemGrid2 from '~/components/ui/ItemGrid2.astro';
import type { Features as Props } from '~/types';

const {
  title,
  subtitle,
  tagline,
  items = [],
  columns = 3,
  defaultIcon,

  id,
  isDark = false,
  classes = {},
} = Astro.props;

const hasTitleSlot = Astro.slots.has('title');
const hasSubtitleSlot = Astro.slots.has('subtitle');
const hasTaglineSlot = Astro.slots.has('tagline');
const hasBgSlot = Astro.slots.has('bg');
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`}>
  {hasBgSlot && (
    <Fragment slot="bg">
      <slot name="bg" />
    </Fragment>
  )}
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>}>
    {hasTitleSlot && (
      <Fragment slot="title">
        <slot name="title" />
      </Fragment>
    )}
    {hasSubtitleSlot && (
      <Fragment slot="subtitle">
        <slot name="subtitle" />
      </Fragment>
    )}
    {hasTaglineSlot && (
      <Fragment slot="tagline">
        <slot name="tagline" />
      </Fragment>
    )}
  </Headline>
  <ItemGrid2
    items={items}
    columns={columns}
    defaultIcon={defaultIcon}
    classes={{
      container: 'gap-4 md:gap-6',
      panel:
        'rounded-lg shadow-[0_4px_30px_rgba(0,0,0,0.1)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur border border-[#ffffff29] bg-white dark:bg-slate-900 p-6',
      // panel:
      //   "text-center bg-page items-center md:text-left rtl:md:text-right md:items-start p-6 p-6 rounded-md shadow-xl dark:shadow-none dark:border dark:border-slate-800",
      icon: 'w-12 h-12 mb-6 text-primary',
      ...((classes?.items as Record<string, never>) ?? {}),
    }}
  />
</WidgetWrapper>
