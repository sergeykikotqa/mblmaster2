---
import Image from '~/components/common/Image.astro';

interface HeroSlide {
  src: string;
  alt: string;
  title?: string;
  subtitle?: string;
  kicker?: string;
}

interface Props {
  title: string;
  subtitle: string;
  actions?: Array<{ text: string; href: string; variant?: string }>;
  primaryCtaId?: string;
  secondaryCtaIds?: string[];
  softAction?: { text: string; href: string };
  softNote?: string;
  mobileProof?: string;
  image?: { src: string; alt: string };
  slides?: HeroSlide[];
  badge?: string;
  trustItems?: string[];
  stats?: Array<{ value: string; label: string }>;
}

const {
  title,
  subtitle,
  actions = [],
  primaryCtaId,
  secondaryCtaIds = [],
  softAction,
  softNote,
  mobileProof,
  image,
  slides = [],
  badge,
  trustItems = [],
  stats,
} = Astro.props as Props;

const badgeText = badge || 'Кухни от производителя';
const heroSlides = slides.length
  ? slides
  : image
    ? [{ src: image.src, alt: image.alt, title, subtitle, kicker: badgeText }]
    : [];

const primaryAction = actions.find((item) => item.variant === 'primary') || actions[0];
const secondaryActions = primaryAction ? actions.filter((item) => item !== primaryAction) : actions;
const hasSlider = heroSlides.length > 1;
const fallbackTrustItems = [
  'Бесплатный замер и консультация',
  'Прозрачная смета и фиксированные сроки',
  'Доставка и монтаж под ключ',
];
const trustList = trustItems.length > 0 ? trustItems : fallbackTrustItems;
const fallbackStats = [
  { value: '10+', label: 'лет опыта' },
  { value: '500+', label: 'проектов' },
  { value: '24/7', label: 'поддержка' },
];
const heroStats = Array.isArray(stats) ? stats : fallbackStats;
const isStaticHero = heroSlides.length === 1;
---

<section class="hm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="hm-layout">
      <div class="hm-media" data-hm-slider-root>
        {
          heroSlides.map((slide, idx) => (
            <article
              class="hm-slide"
              data-hm-slide
              data-hm-slide-index={idx}
              data-active={idx === 0 ? 'true' : 'false'}
              aria-hidden={idx === 0 ? 'false' : 'true'}
            >
              <div class="hm-media-slot" data-hm-media-slot>
                {idx === 0 ? (
                  <Image
                    src={slide.src}
                    alt={slide.alt}
                    width={1523}
                    height={600}
                    sizes="(min-width: 1024px) 65vw, 100vw"
                    widths={[480, 768, 1024, 1280]}
                    layout="cover"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    quality={65}
                  />
                ) : (
                  <template data-hm-template>
                    <Image
                      src={slide.src}
                      alt={slide.alt}
                      width={1523}
                      height={600}
                      sizes="(min-width: 1024px) 65vw, 100vw"
                      widths={[480, 768, 1024, 1280]}
                      layout="cover"
                      loading="lazy"
                      fetchpriority="low"
                      decoding="async"
                      quality={65}
                    />
                  </template>
                )}
              </div>
              <div class="hm-overlay" />
              <div class:list={['hm-copy', { 'hm-copy--static': isStaticHero }]}>
                <div class="hm-copy-card">
                  <p class="hm-kicker">{slide.kicker || badgeText}</p>
                  <p class="hm-title">{slide.title || title}</p>
                  <p class="hm-subtitle">{slide.subtitle || subtitle}</p>
                </div>
              </div>
            </article>
          ))
        }

        {
          hasSlider && (
            <>
              <button type="button" class="hm-arrow left" data-hm-prev aria-label="Предыдущий слайд">
                ‹
              </button>
              <button type="button" class="hm-arrow right" data-hm-next aria-label="Следующий слайд">
                ›
              </button>
              <div class="hm-dots">
                {heroSlides.map((slide, idx) => (
                  <button
                    type="button"
                    class:list={['hm-dot', { active: idx === 0 }]}
                    data-hm-dot
                    aria-label={`Слайд ${idx + 1}`}
                    aria-current={idx === 0 ? 'true' : 'false'}
                  >
                    <span class="sr-only">{slide.title || title}</span>
                  </button>
                ))}
              </div>
            </>
          )
        }
      </div>

      <div class:list={['hm-offer', { 'hm-offer--compact-mobile': Boolean(mobileProof) }]}>
        <p class="hm-offer-kicker">{badgeText}</p>
        <h1>{title}</h1>
        <p>{subtitle}</p>

        {mobileProof && <p class="hm-mobile-proof">{mobileProof}</p>}

        <ul class="hm-list">
          {trustList.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <div class="hm-actions">
          {
            primaryAction && (
              <a
                href={primaryAction.href}
                data-cta-placement="hero"
                data-cta={primaryCtaId || 'hero_primary'}
                data-cta-type="primary"
                class="ui-btn-state hm-btn main"
              >
                {primaryAction.text}
              </a>
            )
          }
          {
            secondaryActions.map((action, idx) => (
              <a
                href={action.href}
                data-cta-placement="hero"
                data-cta={secondaryCtaIds[idx] || `hero_secondary_${idx + 1}`}
                data-cta-type="secondary"
                class="ui-btn-state hm-btn sub"
              >
                {action.text}
              </a>
            ))
          }
        </div>

        {
          softAction && (
            <div class="hm-soft">
              <a
                href={softAction.href}
                class="hm-soft-link"
                data-cta="hero_soft"
                data-cta-type="secondary"
                data-cta-placement="hero"
              >
                {softAction.text}
              </a>
              {softNote && <p class="hm-soft-note">{softNote}</p>}
            </div>
          )
        }

        {heroStats.length > 0 && (
          <div class="hm-stats">
            {heroStats.map((item) => (
              <div>
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

{hasSlider && <script src="/scripts/hero-modern-slider.js" defer />}

<style is:inline>
  .hm {
    background:
      radial-gradient(circle at top center, rgb(255 247 241 / 92%) 0%, rgb(255 255 255 / 0%) 52%),
      linear-gradient(180deg, #fff 0%, #fff8f2 100%);
    padding: 0.75rem 0 1.35rem;
  }
  .hm-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 380px);
    align-items: stretch;
    border: 1px solid #ead8ca;
    border-radius: 1.75rem;
    overflow: hidden;
    background: linear-gradient(180deg, #f7efe8 0%, #efdccc 100%);
    box-shadow: 0 24px 60px rgb(59 36 22 / 12%);
  }
  .hm-media {
    position: relative;
    min-height: 32.5rem;
    background: #181311;
    isolation: isolate;
  }
  .hm-media::after {
    content: '';
    position: absolute;
    left: -12%;
    bottom: -14%;
    width: 54%;
    height: 48%;
    background: radial-gradient(circle, rgb(240 196 151 / 26%) 0%, rgb(240 196 151 / 0%) 72%);
    pointer-events: none;
    z-index: 1;
  }
  .hm-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
    overflow: hidden;
  }
  .hm-media-slot {
    position: absolute;
    inset: 0;
  }
  .hm-media-slot picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hm-slide[data-active='true'] {
    opacity: 1;
    pointer-events: auto;
  }
  .hm-media-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hm-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgb(14 11 10 / 5%) 0%, rgb(14 11 10 / 12%) 40%, rgb(14 11 10 / 28%) 72%, rgb(14 11 10 / 54%) 100%),
      linear-gradient(90deg, rgb(16 12 10 / 42%) 0%, rgb(16 12 10 / 22%) 38%, rgb(16 12 10 / 10%) 72%, rgb(16 12 10 / 14%) 100%);
  }
  .hm-copy {
    position: absolute;
    left: clamp(1.2rem, 2.2vw, 1.9rem);
    right: clamp(1.2rem, 2vw, 2rem);
    bottom: clamp(1.2rem, 2vw, 1.8rem);
    z-index: 4;
    color: #fff;
  }
  .hm-copy-card {
    width: min(43rem, calc(100% - 6rem));
    padding: 1.15rem 1.25rem 1.2rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 1.5rem;
    background: linear-gradient(180deg, rgb(17 13 11 / 46%) 0%, rgb(17 13 11 / 22%) 100%);
    backdrop-filter: blur(18px);
    box-shadow: 0 22px 44px rgb(10 6 4 / 28%);
  }
  .hm-copy--static .hm-copy-card {
    width: min(42rem, 100%);
  }
  .hm-kicker {
    margin: 0;
    display: inline-flex;
    align-items: center;
    border: 1px solid rgb(255 255 255 / 20%);
    background: rgb(247 214 176 / 10%);
    border-radius: 999px;
    color: #f8e2c7;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.36rem 0.82rem;
  }
  .hm-title {
    margin: 0.82rem 0 0;
    max-width: 16ch;
    font-size: clamp(1.88rem, 3vw, 3.05rem);
    line-height: 1.04;
    font-weight: 800;
    text-wrap: balance;
  }
  .hm-copy--static .hm-title {
    max-width: 15ch;
    font-size: clamp(1.95rem, 2.7vw, 2.9rem);
  }
  .hm-subtitle {
    margin: 0.8rem 0 0;
    max-width: 35rem;
    font-size: clamp(1rem, 1.25vw, 1.08rem);
    line-height: 1.58;
    color: rgb(255 255 255 / 92%);
  }
  .hm-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 1rem;
    background: rgb(255 255 255 / 14%);
    backdrop-filter: blur(16px);
    color: #fff;
    font-size: 1.85rem;
    line-height: 1;
    z-index: 5;
    box-shadow: 0 16px 28px rgb(9 7 5 / 18%);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }
  .hm-arrow.left {
    left: 1rem;
  }
  .hm-arrow.right {
    right: 1rem;
  }
  .hm-arrow:hover {
    background: rgb(255 255 255 / 22%);
    border-color: rgb(255 255 255 / 34%);
    transform: translateY(-50%) scale(1.02);
  }
  .hm-dots {
    position: absolute;
    right: 1.15rem;
    bottom: 1.15rem;
    display: flex;
    gap: 0.45rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 999px;
    background: rgb(255 255 255 / 10%);
    backdrop-filter: blur(16px);
    z-index: 5;
  }
  .hm-dot {
    width: 2.1rem;
    height: 0.55rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    padding: 0;
  }
  .hm-dot::before {
    content: '';
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: rgb(255 255 255 / 34%);
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      opacity 180ms ease;
  }
  .hm-dot.active {
    width: 2.75rem;
  }
  .hm-dot.active::before {
    background: #f6d6b3;
    transform: scaleY(1.02);
  }
  .hm-offer {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.65rem 1.4rem 1.35rem;
    color: #2f2219;
    background:
      linear-gradient(180deg, rgb(247 237 227 / 96%) 0%, rgb(240 223 205 / 98%) 52%, rgb(226 194 164 / 98%) 100%);
  }
  .hm-offer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(255 255 255 / 34%) 0%, rgb(255 255 255 / 0%) 42%);
    pointer-events: none;
  }
  .hm-offer > * {
    position: relative;
    z-index: 1;
  }
  .hm-offer-kicker {
    margin: 0;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 700;
    color: #946042;
  }
  .hm-offer h1 {
    margin: 0.7rem 0 0;
    font-size: clamp(1.9rem, 2.6vw, 2.8rem);
    line-height: 1.06;
    color: #2d1e15;
    text-wrap: balance;
  }
  .hm-offer p {
    margin: 0.82rem 0 0;
    color: rgb(73 50 37 / 88%);
    line-height: 1.58;
  }
  .hm-list {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
    font-size: 0.9rem;
  }
  .hm-list li {
    position: relative;
    padding-left: 1.15rem;
    color: #5b4030;
  }
  .hm-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #b27752 0%, #8a5838 100%);
    box-shadow: 0 0 0 4px rgb(255 255 255 / 26%);
  }
  .hm-actions {
    margin-top: 1.1rem;
    display: grid;
    gap: 0.6rem;
  }
  .hm-soft {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.3rem;
  }
  .hm-soft-link {
    display: inline-flex;
    align-items: center;
    color: #654431;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    gap: 0.32rem;
  }
  .hm-soft-link:hover {
    text-decoration: underline;
  }
  .hm-soft-note {
    margin: 0;
    color: rgb(91 64 48 / 78%);
    font-size: 0.78rem;
  }
  .hm-mobile-proof {
    display: none;
    margin: 0.75rem 0 0;
    padding: 0.7rem 0.8rem;
    border: 1px solid rgb(130 89 62 / 14%);
    border-radius: 0.95rem;
    background: rgb(255 255 255 / 48%);
    color: #4e3527;
    font-size: 0.79rem;
    font-weight: 700;
    line-height: 1.45;
  }
  .hm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    font-size: 0.93rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.94rem 1rem;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }
  .hm-btn.main {
    border: 1px solid #8d5938;
    background: linear-gradient(135deg, #a66d48 0%, #8a5637 100%);
    color: #fff;
    box-shadow: 0 16px 28px rgb(113 71 47 / 22%);
  }
  .hm-btn.main:hover {
    background: linear-gradient(135deg, #986342 0%, #7d4d31 100%);
    color: #fff;
    text-decoration: none;
    transform: translateY(-1px);
  }
  .hm-btn.sub {
    border: 1px solid rgb(123 83 57 / 18%);
    background: rgb(255 255 255 / 42%);
    color: #523728;
  }
  .hm-btn.sub:hover {
    background: rgb(255 255 255 / 62%);
    color: #412a1e;
    text-decoration: none;
    transform: translateY(-1px);
  }
  .hm-stats {
    margin-top: auto;
    padding-top: 1.15rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }
  .hm-stats > div {
    min-height: 100%;
    padding: 0.82rem 0.72rem;
    border-radius: 1rem;
    background: rgb(255 255 255 / 46%);
    border: 1px solid rgb(123 83 57 / 14%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 38%);
  }
  .hm-stats strong {
    display: block;
    font-size: 1.05rem;
    line-height: 1.1;
    color: #3a2619;
  }
  .hm-stats span {
    display: block;
    margin-top: 0.16rem;
    font-size: 0.74rem;
    line-height: 1.35;
    color: rgb(92 66 49 / 84%);
  }
  @media (max-width: 1180px) {
    .hm-layout {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 348px);
    }
    .hm-title {
      font-size: clamp(1.9rem, 3vw, 3rem);
    }
  }
  @media (max-width: 980px) {
    .hm-layout {
      grid-template-columns: 1fr;
    }
    .hm-media {
      min-height: 25.5rem;
    }
    .hm-copy-card {
      width: min(38rem, 100%);
    }
    .hm-offer {
      padding: 1.15rem 1rem 1rem;
    }
    .hm-offer h1 {
      font-size: clamp(1.55rem, 5vw, 2.05rem);
    }
    .hm-stats {
      margin-top: 1rem;
    }
  }
  @media (max-width: 720px) {
    .hm-media {
      min-height: 20.5rem;
    }
    .hm-copy {
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
    }
    .hm-copy-card {
      width: 100%;
      padding: 0.95rem 1rem 1rem;
      border-radius: 1.2rem;
    }
    .hm-kicker {
      font-size: 0.66rem;
      padding: 0.3rem 0.68rem;
    }
    .hm-title {
      margin-top: 0.7rem;
      font-size: clamp(1.6rem, 8vw, 2.15rem);
      max-width: 100%;
    }
    .hm-subtitle {
      margin-top: 0.6rem;
      font-size: 0.92rem;
      line-height: 1.5;
    }
    .hm-arrow {
      width: 2.55rem;
      height: 2.55rem;
      font-size: 1.55rem;
      border-radius: 0.9rem;
    }
    .hm-arrow.left {
      left: 0.7rem;
    }
    .hm-arrow.right {
      right: 0.7rem;
    }
    .hm-dots {
      right: 0.8rem;
      bottom: 0.8rem;
      gap: 0.35rem;
      padding: 0.36rem 0.42rem;
    }
    .hm-offer {
      padding: 1.15rem 1rem 1rem;
    }
    .hm-list {
      gap: 0.45rem;
      font-size: 0.84rem;
    }
    .hm-actions {
      grid-template-columns: 1fr;
    }
    .hm-offer--compact-mobile {
      padding: 0.95rem 0.9rem 0.9rem;
    }
    .hm-offer--compact-mobile h1 {
      margin-top: 0.45rem;
      font-size: clamp(1.3rem, 6vw, 1.6rem);
    }
    .hm-offer--compact-mobile > p:not(.hm-offer-kicker):not(.hm-mobile-proof) {
      margin-top: 0.45rem;
      font-size: 0.88rem;
      line-height: 1.45;
    }
    .hm-offer--compact-mobile .hm-mobile-proof {
      display: block;
      order: 3;
      margin-top: 0.55rem;
    }
    .hm-offer--compact-mobile .hm-actions {
      order: 4;
      margin-top: 0.7rem;
      gap: 0.35rem;
    }
    .hm-offer--compact-mobile .hm-list {
      order: 5;
      margin-top: 0.7rem;
      gap: 0.3rem;
      font-size: 0.8rem;
    }
    .hm-offer--compact-mobile .hm-soft {
      display: none;
    }
    .hm-offer--compact-mobile .hm-stats {
      display: none;
    }
    .hm-offer--compact-mobile .hm-btn {
      padding: 0.78rem 0.85rem;
      font-size: 0.86rem;
    }
  }
</style>

