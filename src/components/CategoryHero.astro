---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import { getBusinessInfo } from '~/config/business-info';

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  accent?: string;
  image?: { src: string | ImageMetadata; alt?: string };
}

const { title = '', subtitle = '', description = '', accent = '', image } = Astro.props as Props;
const businessInfo = getBusinessInfo();
const phoneHref = `tel:${businessInfo.phoneHref}`;
---

<section
  class="relative overflow-hidden py-14 sm:py-18 lg:py-24 bg-gradient-to-br from-white via-blue-50 to-white"
  aria-label="Category hero"
>
  <div class="absolute inset-0 pointer-events-none">
    {
      image?.src && (
        <Image
          src={image.src}
          alt={image.alt || title || 'Категория мебели'}
          class="w-full h-full object-cover opacity-10"
          loading="eager"
          widths={[640, 960, 1280, 1600]}
          sizes="100vw"
          width={1600}
          height={939}
          layout="responsive"
        />
      )
    }
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="max-w-4xl">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4">{title}</h1>
      {subtitle && <p class="text-lg sm:text-xl text-slate-700 mb-4">{subtitle}</p>}
      {description && <p class="text-slate-600 mb-8">{description}</p>}

      <div class="flex flex-wrap gap-4 items-center">
        <a
          href="#contact"
          data-cta-placement="hero"
          data-cta="category_hero_primary"
          data-cta-type="primary"
          class="ui-btn-state inline-flex items-center justify-center px-7 py-4 rounded-lg font-semibold bg-gradient-to-r from-blue-600 to-blue-700 text-white hover:from-blue-700 hover:to-blue-800 transition-all shadow-lg"
        >
          Оставить заявку
        </a>
        <a
          href={phoneHref}
          data-cta-placement="hero"
          data-cta="category_hero_phone"
          data-cta-type="phone"
          class="ui-btn-state rounded-sm text-blue-700 underline underline-offset-4 font-medium"
        >
          {businessInfo.phone}
        </a>
        {
          accent && (
            <span class="inline-flex items-center px-4 py-2 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-semibold">
              {accent}
            </span>
          )
        }
      </div>
    </div>
  </div>
</section>
