---
import { ANALYTICS } from 'astrowind:config';
import GoogleAnalytics from './GoogleAnalytics.astro';

const googleAnalyticsId = ANALYTICS?.vendors?.googleAnalytics?.id || import.meta.env.PUBLIC_GA4_ID || null;
---

{
  googleAnalyticsId ? (
    <GoogleAnalytics id={String(googleAnalyticsId)} partytown={ANALYTICS?.vendors?.googleAnalytics?.partytown} />
  ) : null
}
