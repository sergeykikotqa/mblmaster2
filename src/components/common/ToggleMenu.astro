---
export interface Props {
  label?: string;
  class?: string;
  controls?: string;
}

const { label = 'Открыть меню', class: className = '', controls } = Astro.props;

const composedClassName = [
  'group relative inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg cursor-pointer transition-colors duration-200',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<button
  type="button"
  class={composedClassName}
  aria-label={label}
  aria-expanded="false"
  aria-controls={controls}
  data-aw-toggle-menu
>
  <span class="sr-only">{label}</span>
  <slot>
    <span aria-hidden="true" class="menu-toggle-bar menu-toggle-bar-top"></span>
    <span aria-hidden="true" class="menu-toggle-bar menu-toggle-bar-middle"></span>
    <span aria-hidden="true" class="menu-toggle-bar menu-toggle-bar-bottom"></span>
  </slot>
</button>

<style is:inline>
  .menu-toggle-bar {
    position: absolute;
    left: 50%;
    width: 1.25rem;
    height: 0.125rem;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .menu-toggle-bar-top {
    transform: translate(-50%, -0.36rem);
  }

  .menu-toggle-bar-middle {
    transform: translate(-50%, 0);
  }

  .menu-toggle-bar-bottom {
    transform: translate(-50%, 0.36rem);
  }

  [data-aw-toggle-menu].expanded .menu-toggle-bar-top {
    transform: translate(-50%, 0) rotate(45deg);
  }

  [data-aw-toggle-menu].expanded .menu-toggle-bar-middle {
    opacity: 0;
  }

  [data-aw-toggle-menu].expanded .menu-toggle-bar-bottom {
    transform: translate(-50%, 0) rotate(-45deg);
  }
</style>
