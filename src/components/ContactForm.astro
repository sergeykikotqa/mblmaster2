---
import { getBusinessInfo } from '~/config/business-info';

interface Props {
  successText?: string;
  formContext?: string;
  title?: string;
  subtitle?: string;
  cta?: string;
  preCtaNote?: string;
  ctaNote?: string;
  trustNote?: string | string[];
  successItems?: string[];
  successLink?: { label: string; href: string };
  extraHiddenFields?: { name: string; value?: string }[];
  leadContext?: {
    city?: string;
    district?: string;
    service?: string;
    pageType?: string;
    pageSlug?: string;
  };
}

const {
  successText = 'Спасибо! Заявка получена. Мы свяжемся с вами для уточнения деталей.',
  formContext = 'section',
  title = '',
  subtitle = '',
  cta = 'Рассчитать стоимость',
  preCtaNote = '',
  ctaNote = '',
  trustNote,
  successItems = [],
  successLink,
  extraHiddenFields = [],
  leadContext = {},
} = Astro.props as Props;

const idPrefix = `lead-${String(formContext).replace(/[^a-zA-Z0-9_-]/g, '-')}`;
const formAnchorId = formContext === 'contact' ? 'form' : '';
const errorIds = {
  name: `${idPrefix}-error-name`,
  phone: `${idPrefix}-error-phone`,
  message: `${idPrefix}-error-message`,
  consent: `${idPrefix}-error-consent`,
  smartCaptcha: `${idPrefix}-error-smartcaptcha`,
};
const consentHintId = `${idPrefix}-consent-hint`;
const businessInfo = getBusinessInfo();
const phoneHref = `tel:${businessInfo.phoneHref}`;

const serviceKey = String(leadContext?.service || '')
  .trim()
  .toLowerCase();

const serviceCopyMap = {
  kuhni: {
    phoneLabel: 'Телефон для расчёта кухни',
    phoneHint: 'Оставьте номер телефона, чтобы мы могли связаться с вами по заявке.',
    messageLabel: 'Что нужно рассчитать',
    messagePlaceholder: 'Например: угловая кухня, встроенная техника, длина 3,2 м.',
    preCtaNote: 'Рассчитаем стоимость кухни с учётом техники, розеток и вентиляции.',
    ctaNote: 'Свяжемся, чтобы уточнить детали и рассчитать стоимость под ваш проект.',
    trustNotes: ['Без обязательств', 'Смета и сроки фиксируются до запуска'],
  },
  shkafy: {
    phoneLabel: 'Телефон для расчёта шкафа',
    phoneHint: 'Оставьте номер телефона, чтобы мы могли связаться с вами по заявке.',
    messageLabel: 'Что нужно рассчитать',
    messagePlaceholder: 'Например: шкаф-купе в нишу, высота 260 см, зеркало и полки.',
    preCtaNote: 'Рассчитаем стоимость шкафа по размерам, наполнению и типу фасадов.',
    ctaNote: 'Свяжемся, чтобы уточнить детали и рассчитать стоимость под ваш проект.',
    trustNotes: ['Без обязательств', 'Смета и сроки фиксируются до запуска'],
  },
  garderobnye: {
    phoneLabel: 'Телефон для расчёта гардеробной',
    phoneHint: 'Оставьте номер телефона, чтобы мы могли связаться с вами по заявке.',
    messageLabel: 'Что нужно рассчитать',
    messagePlaceholder: 'Например: П-образная гардеробная, хранение сезонной одежды и обуви.',
    preCtaNote: 'Рассчитаем стоимость гардеробной по размерам, хранению и типу фасадов.',
    ctaNote: 'Свяжемся, чтобы уточнить детали и подобрать конфигурацию под ваш сценарий хранения.',
    trustNotes: ['Без обязательств', 'Смета и сроки фиксируются до запуска'],
  },
  default: {
    phoneLabel: 'Телефон для расчёта стоимости',
    phoneHint: 'Оставьте номер телефона, чтобы мы могли связаться с вами по заявке.',
    messageLabel: 'Что нужно рассчитать',
    messagePlaceholder: 'Коротко опишите задачу или размеры.',
    preCtaNote: '',
    ctaNote: 'Свяжемся, чтобы уточнить детали и предложить следующий шаг.',
    trustNotes: ['Без обязательств', 'Достаточно телефона и короткого описания задачи'],
  },
} as const;

const serviceCopy = serviceCopyMap[serviceKey as keyof typeof serviceCopyMap] ?? serviceCopyMap.default;

const normalizedTrustNotes = Array.isArray(trustNote)
  ? trustNote
  : String(trustNote || '')
      .split('•')
      .map((item) => item.trim())
      .filter(Boolean);
const resolvedTrustNotes = normalizedTrustNotes.length > 0 ? normalizedTrustNotes : serviceCopy.trustNotes;
const resolvedPreCtaNote = preCtaNote || serviceCopy.preCtaNote;
const resolvedCtaNote = ctaNote || serviceCopy.ctaNote;
---

{formAnchorId && <div id={formAnchorId} class="sr-only" aria-hidden="true" />}
<noscript>
  <style>
    form.mbl-js-contact-form,
    form.mbl-js-contact-form * {
      display: none !important;
      visibility: hidden !important;
      height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: hidden !important;
    }
    .mbl-contact-form-noscript {
      display: block !important;
    }
  </style>
  <div
    class="mbl-contact-form-noscript mb-6 rounded-2xl border border-[#ead9cc] bg-[#fff8f3] p-4 text-slate-700"
    role="status"
    aria-live="polite"
    data-nojs-fallback
  >
    <p class="text-base font-semibold text-slate-900" data-nojs-message>Для отправки заявки нужен JavaScript.</p>
    <p class="mt-2 text-sm text-slate-700">
      Онлайн-форма временно недоступна. Чтобы оставить заявку, позвоните нам напрямую.
    </p>
    <a
      href={phoneHref}
      class="mt-3 inline-flex items-center gap-2 font-semibold text-[#7f5438] underline"
      data-nojs-phone-link
    >
      Позвонить {businessInfo.phone}
    </a>
  </div>
</noscript>
<form
  id={`${idPrefix}-form`}
  class="mbl-js-contact-form lead-contact-form w-full rounded-2xl border border-[#e6d9cf] bg-white p-6 shadow-lg shadow-[#e7d9ce]/70 sm:p-8 lg:p-10"
  method="post"
  action="/api/leads"
  novalidate
  data-form-context={formContext}
  data-form-attention="false"
>
  <div data-form-content>
    {
      (title || subtitle) && (
        <div class="mb-6">
          {title && <h3 class="text-2xl font-bold text-slate-900 mb-2">{title}</h3>}
          {subtitle && <p class="text-slate-600">{subtitle}</p>}
        </div>
      )
    }
    <div class="mb-6">
      <label for={`${idPrefix}-phone`} class="block text-sm font-semibold text-slate-900 mb-2"
        >{serviceCopy.phoneLabel} <span class="text-red-500">*</span></label
      >
      <p class="mb-2 text-xs text-slate-600">{serviceCopy.phoneHint}</p>
      <input
        id={`${idPrefix}-phone`}
        name="phone"
        type="tel"
        inputmode="tel"
        required
        autocomplete="tel"
        enterkeyhint="next"
        aria-describedby={errorIds.phone}
        class="w-full rounded-lg border border-[#d9c6b7] px-4 py-3.5 text-slate-900 placeholder:text-slate-400 transition-colors duration-200 focus-visible:border-[#8b5a3c] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ead9cc]"
        placeholder="+7 (999) 123-45-67"
        data-first-input
      />
      <p
        id={errorIds.phone}
        class="mt-2 text-sm text-red-600 hidden"
        role="alert"
        aria-live="assertive"
        data-error-phone
      >
        Пожалуйста, введите корректный номер телефона.
      </p>
    </div>

    <div class="mb-6">
      <label for={`${idPrefix}-name`} class="block text-sm font-semibold text-slate-900 mb-2"
        >Как к вам обращаться <span class="text-red-500">*</span></label
      >
      <input
        id={`${idPrefix}-name`}
        name="name"
        type="text"
        required
        autocomplete="name"
        enterkeyhint="next"
        aria-describedby={errorIds.name}
        class="w-full rounded-lg border border-[#d9c6b7] px-4 py-3.5 text-slate-900 placeholder:text-slate-400 transition-colors duration-200 focus-visible:border-[#8b5a3c] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ead9cc]"
        placeholder="Например, Иван"
      />
      <p id={errorIds.name} class="mt-2 text-sm text-red-600 hidden" role="alert" aria-live="assertive" data-error-name>
        Пожалуйста, укажите ваше имя.
      </p>
    </div>

    <div class="mb-6">
      <label for={`${idPrefix}-message`} class="block text-sm font-semibold text-slate-900 mb-2"
        >{serviceCopy.messageLabel} (опционально)</label
      >
      <textarea
        id={`${idPrefix}-message`}
        name="message"
        rows="4"
        maxlength="2000"
        aria-describedby={errorIds.message}
        class="min-h-[120px] w-full resize-none rounded-lg border border-[#d9c6b7] px-4 py-3.5 text-slate-900 placeholder:text-slate-400 transition-colors duration-200 focus-visible:border-[#8b5a3c] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ead9cc]"
        placeholder={serviceCopy.messagePlaceholder}></textarea>
      <p
        id={errorIds.message}
        class="mt-2 text-sm text-red-600 hidden"
        role="alert"
        aria-live="assertive"
        data-error-message
      >
        Сообщение слишком длинное.
      </p>
    </div>

    <div class="mb-8 flex items-start gap-3">
      <div class="flex items-center h-10 pt-0">
        <input
          id={`${idPrefix}-consent`}
          name="consent"
          type="checkbox"
          required
          aria-describedby={`${consentHintId} ${errorIds.consent}`}
          class="h-10 w-10 cursor-pointer rounded border-[#d9c6b7] text-[#8b5a3c] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#8b5a3c] focus-visible:ring-offset-1 sm:h-8 sm:w-8"
        />
      </div>
      <div>
        <label for={`${idPrefix}-consent`} class="text-sm font-medium text-slate-900 cursor-pointer">
          Я согласен(а) на обработку персональных данных
        </label>
        <p id={consentHintId} class="text-xs text-slate-600 mt-1">
          Ваши данные будут использоваться только для связи с вами
        </p>
      </div>
    </div>
    <p
      id={errorIds.consent}
      class="mt-2 mb-6 text-sm text-red-600 hidden"
      role="alert"
      aria-live="assertive"
      data-error-consent
    >
      Подтвердите согласие на обработку персональных данных.
    </p>

    <div
      class="mb-6 hidden rounded-2xl border border-[#e6d9cf] bg-[#faf5f1] p-4"
      data-smartcaptcha-step
      hidden
      aria-hidden="true"
    >
      <div class="space-y-3">
        <div>
          <p class="text-sm font-semibold text-slate-900">Защита формы от спама</p>
          <p class="mt-1 text-xs text-slate-600" data-smartcaptcha-help>
            Показываем проверку только после телефона, чтобы не тормозить первый шаг.
          </p>
        </div>
        <div id={`${idPrefix}-smartcaptcha`} class="min-h-[100px] w-full max-w-full" data-smartcaptcha-widget></div>
        <p class="text-xs text-slate-600">
          Проверку выполняет Yandex SmartCaptcha. Подробнее об обработке данных — в <a
            href="/privacy"
            class="font-semibold text-[#7f5438] underline">политике конфиденциальности</a
          >.
        </p>
        <p
          id={errorIds.smartCaptcha}
          class="text-sm text-red-600 hidden"
          role="alert"
          aria-live="assertive"
          data-error-smartcaptcha
        >
          Подтвердите, что вы не робот.
        </p>
      </div>
    </div>

    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input type="hidden" name="redirectTo" value="/thanks" />
    <input type="hidden" name="city" value={leadContext.city || ''} />
    <input type="hidden" name="district" value={leadContext.district || ''} />
    <input type="hidden" name="service" value={leadContext.service || ''} />
    <input type="hidden" name="pageType" value={leadContext.pageType || ''} />
    <input type="hidden" name="pageSlug" value={leadContext.pageSlug || ''} />
    {
      extraHiddenFields.map((field) => (
        <input type="hidden" name={field.name} value={field.value ?? ''} data-extra-field={field.name} />
      ))
    }

    {resolvedPreCtaNote && <p class="text-xs font-semibold text-slate-700">{resolvedPreCtaNote}</p>}
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <button
        type="submit"
        data-submit-btn
        data-cta={`${idPrefix}-submit`}
        data-cta-type="primary"
        data-cta-placement="form"
        class="ui-btn-state w-full rounded-lg bg-[#8b5a3c] px-8 py-4 font-semibold text-white shadow-lg shadow-[#8d5d3d]/25 transition-all duration-200 hover:bg-[#7f5438] focus-visible:ring-[#8b5a3c] sm:w-auto"
      >
        <span data-btn-text>{cta}</span>
      </button>
      <button
        type="button"
        data-retry-btn
        data-cta={`${idPrefix}-retry`}
        data-cta-type="secondary"
        data-cta-placement="form"
        class="ui-btn-state hidden w-full rounded-lg border border-[#d9c6b7] px-6 py-4 font-semibold text-slate-700 transition-colors hover:bg-[#faf5f1] focus-visible:ring-[#8b5a3c] sm:w-auto"
      >
        Повторить отправку
      </button>
      <div class="hidden text-sm font-medium" data-form-status aria-live="polite" role="status"></div>
    </div>
    <div
      class="mt-3 hidden rounded-xl border border-[#ead9cc] bg-[#fff8f3] px-4 py-3 text-sm text-slate-700"
      data-submit-fallback
      aria-live="polite"
      role="status"
    >
      <p data-submit-fallback-copy>Если форма временно не отправляется, можно сразу позвонить.</p>
      <a
        href={phoneHref}
        class="mt-2 inline-flex items-center gap-2 font-semibold text-[#7f5438] underline"
        data-submit-fallback-call
      >
        Позвонить {businessInfo.phone}
      </a>
    </div>
    {
      (resolvedCtaNote || resolvedTrustNotes.length > 0) && (
        <div class="mt-3 space-y-1 text-xs text-slate-600">
          {resolvedCtaNote && <p>{resolvedCtaNote}</p>}
          {resolvedTrustNotes.map((item: string) => (
            <p>{item}</p>
          ))}
        </div>
      )
    }
  </div>

  <div data-success-box class="hidden">
    <div class="p-6 bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 rounded-lg">
      <div class="flex items-start gap-3">
        <div class="w-6 h-6 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-green-900">{successText}</p>
          <p class="text-sm text-green-700 mt-1">Мы свяжемся с вами в ближайшее время для уточнения деталей.</p>
          {
            successItems.length > 0 && (
              <ul class="mt-3 text-sm text-green-700 list-disc list-inside space-y-1">
                {successItems.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )
          }
          {
            successLink && (
              <a
                href={successLink.href}
                class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-green-900 underline"
              >
                {successLink.label}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</form>
