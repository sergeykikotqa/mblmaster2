---
interface Props {
  title?: string;
  paragraphs?: string[];
  content?: string;
  class?: string;
}

const { title = '', paragraphs = [], content = '', class: className = '' } = Astro.props as Props;
const hasParagraphs = Array.isArray(paragraphs) && paragraphs.length > 0;
---

<section class={`max-w-5xl mx-auto px-4 py-12 sm:py-16 ${className}`}>
  <div class="mbl-seo-text-surface rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 lg:p-10">
    {title && <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6">{title}</h2>}

    {
      content ? (
        <div class="prose prose-slate max-w-none prose-headings:text-slate-900 prose-p:text-slate-700 prose-li:text-slate-700">
          {content}
        </div>
      ) : (
        <div class="space-y-4 text-slate-700">{hasParagraphs && paragraphs.map((p) => <p>{p}</p>)}</div>
      )
    }
  </div>
</section>
